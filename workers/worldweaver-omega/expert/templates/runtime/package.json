{
  "name": "worldweaver-runtime",
  "private": true,
  "type": "module",
  "dependencies": {
    "three": "0.186.0",
    "playwright": "1.63.0",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --outdir=dist --entry-names=app && esbuild src/chunk-worker.js --bundle --format=esm --outfile=dist/chunk-worker.js",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist"
  }
}
