#!/usr/bin/env python3
import hashlib, json, os, pathlib, re, stat, sys
sys.dont_write_bytecode = True

MAX_FILE = 16 * 1024 * 1024
MAX_TOTAL = 64 * 1024 * 1024
MAX_FILES = 256
MAX_INPUT = 1024 * 1024
SAFE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")

def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)

def clean_path(value):
    if not isinstance(value, str) or "\\" in value:
        fail("invalid relative output path")
    p = pathlib.PurePosixPath(value)
    if str(p) != value or p.is_absolute() or len(p.parts) < 2 or p.parts[0] != "output":
        fail("invalid relative output path")
    if any(x in ("", ".", "..") for x in p.parts):
        fail("invalid relative output path")
    return p

def regular_without_symlinks(path, root):
    try:
        path.relative_to(root)
        current = root
        if stat.S_ISLNK(os.lstat(current).st_mode):
            fail("symlink in source path")
        for part in path.relative_to(root).parts:
            current = current / part
            mode = os.lstat(current).st_mode
            if stat.S_ISLNK(mode):
                fail("symlink in source path")
        if not stat.S_ISREG(os.lstat(path).st_mode):
            fail("manifest source is not a regular file")
    except (OSError, ValueError) as e:
        fail("invalid manifest source: " + str(e))

def load_raw(raw):
    if len(raw) > MAX_INPUT:
        fail("handoff JSON exceeds input limit")
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as e:
        fail("invalid handoff JSON: " + str(e))

if len(sys.argv) == 2:
    with open(sys.argv[1], 'rb') as stream:
        raw = stream.read(MAX_INPUT + 1)
else:
    raw = sys.stdin.buffer.read(MAX_INPUT + 1)
obj = load_raw(raw)
if not isinstance(obj, dict) or obj.get("schema") != "page-team.handoff/v1":
    fail("invalid handoff schema")
if not isinstance(obj.get("task_id"), str) or not obj["task_id"]:
    fail("invalid task_id")
if not isinstance(obj.get("specialist"), str) or not SAFE.fullmatch(obj["specialist"]):
    fail("invalid specialist")
files = obj.get("files")
if not isinstance(files, list) or not files or len(files) > MAX_FILES:
    fail("invalid handoff files")
cwd = pathlib.Path.cwd().absolute()
root = cwd / "output"
seen, total = set(), 0
for item in files:
    if not isinstance(item, dict) or set(item) != {"path", "bytes", "sha256", "media_type", "source"}:
        fail("invalid file manifest fields")
    rel = clean_path(item["path"])
    if str(rel) in seen:
        fail("duplicate output path")
    seen.add(str(rel))
    size = item["bytes"]
    if isinstance(size, bool) or not isinstance(size, int) or size < 0 or size > MAX_FILE:
        fail("invalid file size")
    total += size
    if total > MAX_TOTAL:
        fail("handoff exceeds total size limit")
    digest = item["sha256"]
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        fail("invalid file digest")
    if not isinstance(item["media_type"], str) or not item["media_type"]:
        fail("invalid media type")
    expected = cwd / pathlib.Path(*rel.parts)
    if not isinstance(item["source"], str) or not pathlib.PurePath(item["source"]).is_absolute():
        fail("manifest source must be absolute")
    if pathlib.Path(item["source"]) != expected:
        fail("manifest source mismatch")
    regular_without_symlinks(expected, root)
    try:
        with expected.open('rb') as stream:
            data = stream.read(size + 1)
    except OSError as e:
        fail("cannot read manifest source: " + str(e))
    if len(data) != size or hashlib.sha256(data).hexdigest() != digest:
        fail("manifest size/digest mismatch")
print("validated handoff with %d bound files" % len(files))
