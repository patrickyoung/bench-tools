#!/usr/bin/env python3
"""Fixed entry point: model intent enters only through the bounded plan."""
import sys
sys.dont_write_bytecode = True
from authoring import author
try:
    if len(sys.argv) != 1:
        raise ValueError("accepts no arguments")
    author()
except (ValueError, OSError) as e:
    print("author: "+str(e), file=sys.stderr)
    sys.exit(1)
