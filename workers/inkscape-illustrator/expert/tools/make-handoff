#!/usr/bin/env python3
# Adapted from Bench page-team's MIT-licensed make-handoff utility.
import sys
sys.dont_write_bytecode = True
import hashlib,json,mimetypes,os,pathlib,stat
MAX_FILE=64*1024*1024
if len(sys.argv)<4:
    raise SystemExit("usage: make-handoff SPECIALIST SUMMARY FILE...")
root=pathlib.Path.cwd().resolve(); files=[]
def bounded(path,limit):
    info=os.lstat(path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise SystemExit("artifact must be a regular non-symlink")
    if info.st_size>limit: raise SystemExit("artifact exceeds size bound")
    with path.open("rb") as stream: data=stream.read(limit+1)
    if len(data)>limit: raise SystemExit("artifact exceeds size bound")
    return data
for value in sys.argv[3:]:
    p=(root/value).resolve()
    try: p.relative_to(root/"output")
    except ValueError: raise SystemExit("artifact must be below output/")
    b=bounded(p,MAX_FILE)
    files.append({"path":str(p.relative_to(root)),"bytes":len(b),
      "sha256":hashlib.sha256(b).hexdigest(),
      "media_type":mimetypes.guess_type(p.name)[0] or "application/octet-stream",
      "source":str(p)})
request=root/"request.json"
b=bounded(request,64*1024)
obj={"schema":"page-team.handoff/v1","task_id":os.environ.get("PAGE_TEAM_TASK_ID","ordinary-agent-run"),
 "specialist":sys.argv[1],"summary":sys.argv[2],"files":files,
 "provenance":[],"limitations":[],
 "request_sha256":hashlib.sha256(b).hexdigest()}
pathlib.Path("handoff.json").write_text(json.dumps(obj,sort_keys=True,indent=2)+"\n")
