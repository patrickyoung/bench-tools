#!/usr/bin/env python3
import json,sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from publication_contract import validate
try:
 role=json.loads((Path(__file__).resolve().parents[1]/"role.json").read_text())["role"]
 validate(Path.cwd(),role)
 print("valid bound "+role+" publication package")
except Exception as e:
 print(str(e),file=sys.stderr);sys.exit(1)
