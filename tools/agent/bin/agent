#!/bin/sh
# Compile an agent home into Brief + Ply + Cage. This program has no model,
# loop, skill parser, session format, or sandbox of its own.

set -eu

ME=agent
VERSION=0.2.1
CONTEXT_MAX=65536
FILE_MAX=32768
PROPOSAL_MAX=16
SKILL_MAX=64
SKILL_BYTES_MAX=262144
TOOL_MAX=128
INPUT_MAX=16777216

say() {
	printf '%s: %s\n' "$ME" "$*" >&2
}

die() {
	say "$*"
	exit 2
}

usage() {
	cat <<'EOF'
agent — compile and run a directory-shaped digital worker

  agent new DIR [description ...]  scaffold an agent home
  agent check [DIR]                validate it without a model
  agent show [DIR]                 print exact composition and authority
  agent run [flags] [DIR] [-- input ...]
                                   pursue GOAL.md until bin/check accepts
  agent tick [flags] [DIR] [-- input ...]
                                   run bin/wake; spend a model call only on work
  agent specialist PARENT NAME [run flags] [-- input ...]
                                   run one direct child with separate evidence
  agent learn -into SKILL [flags] HOME SESSION
                                   offer one verified recovery to Hone
  agent history HOME [COMMAND ...] browse this home's replay evidence
  agent actions HOME [PROPOSAL]   inspect bounded effect proposals; never act
  agent act [-policy PROGRAM] HOME PROPOSAL SESSION
                                   execute one proposal through Action + May
  agent proposals HOME [PATCH]    inspect proposals without changing the home
  agent amend HOME PATCH          apply one reviewed definition patch via May
  agent version                    print the version
  agent help                       print this summary

run flags:
  -net          allow model-authored actions to use the network inside Cage
  -no-cage      use Ply's ordinary host action boundary
  -m MODEL      pass the provider/model literally to Ply
  -effort NAME  pass reasoning effort literally to Ply
  -checkpoint NAME
                resume through this home-scoped conversation checkpoint
  -q            suppress Ply's typescript

specialist:
  agent specialist PARENT NAME [run flags] [-- input ...]
                run one validated direct child home in the foreground

learning:
  agent learn -into SKILL [flags] HOME SESSION
  agent learn -show PROPOSAL HOME
  agent learn -admit PROPOSAL HOME
  flags: -m MODEL -n COUNT -N -why -prepare PROPOSAL -q

history:
  agent history HOME [ls]
  agent history HOME find QUERY
  agent history HOME show SESSION
  agent history HOME window [-before N] [-after N] SESSION SEQ
  agent history HOME lineage SESSION
  agent history HOME check

amendment:
  agent proposals HOME [PATCH]
                print bounded patch bytes and the exact May action; never ask
                for approval or change the home
  agent amend HOME PATCH
                dry-run one root definition-file patch, bind its exact hashes
                through May, then apply and revalidate only after approval

external actions:
  agent actions HOME [PROPOSAL]
                inspect strict JSON proposals under work/actions; never resolve
                a connector, ask for approval, or cause an external effect
  agent act [-policy PROGRAM] HOME PROPOSAL SESSION
                run one proposal outside Cage through Action, bind default
                review to May, and append sealed events to the Ask session

env: AGENT_PLY AGENT_BRIEF AGENT_CAGE AGENT_HONE AGENT_TRAIL AGENT_ASK
     AGENT_MAY AGENT_ACTION override dependencies; AGENT_ACTION_PATH selects
     controller-only Action connectors
exit: run/specialist preserve Ply: 0 accepted · 1 broken · 2 unfinished
      tick: 0 quiet/accepted · 2 broken wake; controller commands preserve
      their composed filter statuses (including 75 parked and 125 uncertain)
EOF
}

tool() {
	case $1 in
		AGENT_PLY) value=${AGENT_PLY:-} ;;
		AGENT_BRIEF) value=${AGENT_BRIEF:-} ;;
		AGENT_CAGE) value=${AGENT_CAGE:-} ;;
		AGENT_HONE) value=${AGENT_HONE:-} ;;
		AGENT_TRAIL) value=${AGENT_TRAIL:-} ;;
		AGENT_ASK) value=${AGENT_ASK:-} ;;
		AGENT_MAY) value=${AGENT_MAY:-} ;;
		AGENT_ACTION) value=${AGENT_ACTION:-} ;;
		*) die "internal unknown tool variable: $1" ;;
	esac
	fallback=$2
	if [ -n "$value" ]; then
		command -v "$value" >/dev/null 2>&1 || die "$1 executable not found: $value"
		command -v "$value"
		return
	fi
	command -v "$fallback" >/dev/null 2>&1 || die "$fallback is required"
	command -v "$fallback"
}

physical_dir() {
	[ -d "$1" ] || return 1
	(
		cd -P "$1" 2>/dev/null || exit 1
		pwd -P
	)
}

resolve_program() {
	program=$1
	case $program in
		*/*) ;;
		*) program=$(command -v "$program") || return 1 ;;
	esac
	case $program in
		/*) ;;
		*) program=$PWD/$program ;;
	esac
	hops=0
	while [ -L "$program" ]; do
		hops=$((hops + 1))
		[ "$hops" -le 32 ] || return 1
		program_dir=$(physical_dir "$(dirname "$program")") || return 1
		target=$(readlink "$program") || return 1
		case $target in
			/*) program=$target ;;
			*) program=$program_dir/$target ;;
		esac
	done
	program_dir=$(physical_dir "$(dirname "$program")") || return 1
	printf '%s/%s\n' "$program_dir" "$(basename "$program")"
}

bytes() {
	wc -c <"$1" | tr -d '[:space:]'
}

nonempty_markdown() {
	# Blank lines and one-line Markdown comments do not make an optional file
	# worth injecting. This is a loading choice, never Markdown interpretation.
	sed '/^[[:space:]]*$/d; /^[[:space:]]*<!--[[:space:][:print:]]*-->[[:space:]]*$/d' "$1" | grep -q .
}

safe_file() {
	path=$1
	label=$2
	[ ! -L "$path" ] || { say "$label may not be a symlink: $path"; return 1; }
	[ -f "$path" ] || { say "$label is not a regular file: $path"; return 1; }
	[ -r "$path" ] || { say "$label is not readable: $path"; return 1; }
	return 0
}

safe_dir() {
	path=$1
	label=$2
	[ ! -L "$path" ] || { say "$label may not be a symlink: $path"; return 1; }
	[ -d "$path" ] || { say "$label is not a directory: $path"; return 1; }
	return 0
}

context_files() {
	for name in AGENTS.md SOUL.md MEMORY.md; do
		path=$HOME_DIR/$name
		if [ -f "$path" ] && nonempty_markdown "$path"; then
			printf '%s\n' "$name"
		fi
	done
}

definition_files() {
	for name in AGENTS.md GOAL.md SOUL.md PLAN.md HEARTBEAT.md MEMORY.md; do
		[ -f "$HOME_DIR/$name" ] && printf '%s\n' "$name"
	done
}

hash_stream() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum | awk '{print $1}'
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 | awk '{print $1}'
	elif command -v openssl >/dev/null 2>&1; then
		openssl dgst -sha256 | awk '{print $NF}'
	else
		die 'show needs sha256sum, shasum, or openssl'
	fi
}

hash_file() {
	hash_stream <"$1"
}

check_hash() {
	hash_stream <"$HOME_DIR/bin/check"
}

wake_hash() {
	hash_stream <"$HOME_DIR/bin/wake"
}

definition_hash() {
	definition_files | while IFS= read -r name; do
		printf '%s\000' "$name"
		cat "$HOME_DIR/$name"
		printf '\000'
	done | hash_stream
}

has_skills() {
	set -- "$HOME_DIR"/skills/*
	[ -e "$1" ] || [ -L "$1" ]
}

validate_skills() {
	skill_count=0
	skill_bytes=0
	skill_rc=0
	set -- "$HOME_DIR"/skills/*
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		return 0
	fi
	for skill_entry do
		skill_count=$((skill_count + 1))
		if [ "$skill_count" -gt "$SKILL_MAX" ]; then
			say "skills/ has more than $SKILL_MAX direct skills"
			skill_rc=1
			break
		fi
		if [ "$(basename "$skill_entry")" = agent-context ]; then
			say "agent-context is reserved for Agent's private compiled context: $skill_entry"
			skill_rc=1
		fi
		if [ -L "$skill_entry" ]; then
			say "skill directory may not be a symlink: $skill_entry"
			skill_rc=1
			continue
		fi
		if [ ! -d "$skill_entry" ]; then
			say "skills/ entries must be skill directories: $skill_entry"
			skill_rc=1
			continue
		fi
		skill_file=$skill_entry/SKILL.md
		if [ -L "$skill_file" ]; then
			say "skill instructions may not be a symlink: $skill_file"
			skill_rc=1
			continue
		fi
		if [ ! -f "$skill_file" ] || [ ! -r "$skill_file" ]; then
			say "skill directory needs a readable regular SKILL.md: $skill_entry"
			skill_rc=1
			continue
		fi
		n=$(bytes "$skill_file")
		if [ "$n" -gt "$FILE_MAX" ]; then
			say "skill instructions are $n bytes; the per-file limit is $FILE_MAX: $skill_file"
			skill_rc=1
		fi
		skill_bytes=$((skill_bytes + n))
	done
	if [ "$skill_bytes" -gt "$SKILL_BYTES_MAX" ]; then
		say "skill instructions total $skill_bytes bytes; the catalogue limit is $SKILL_BYTES_MAX"
		skill_rc=1
	fi
	[ "$skill_rc" -eq 0 ]
}

validate_tools() {
	tool_count=0
	tool_rc=0
	set -- "$HOME_DIR"/tools/*
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		return 0
	fi
	for tool_entry do
		tool_count=$((tool_count + 1))
		if [ "$tool_count" -gt "$TOOL_MAX" ]; then
			say "tools/ has more than $TOOL_MAX direct programs"
			tool_rc=1
			break
		fi
		tool_target=$(resolve_program "$tool_entry") || {
			say "tool does not resolve to a program: $tool_entry"
			tool_rc=1
			continue
		}
		if [ ! -f "$tool_target" ] || [ ! -x "$tool_target" ]; then
			say "tool target must be an executable regular file: $tool_entry -> $tool_target"
			tool_rc=1
			continue
		fi
		case $tool_target in
			"$HOME_DIR/work"|"$HOME_DIR/work"/*|"$HOME_DIR/state"|"$HOME_DIR/state"/*)
				say "tool target may not be inside model-writable work or state: $tool_entry -> $tool_target"
				tool_rc=1
				;;
		esac
		if find "$tool_target" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
			say "tool target may not be multiply linked: $tool_entry -> $tool_target"
			tool_rc=1
		fi
	done
	[ "$tool_rc" -eq 0 ]
}

has_unsafe_hardlinks() {
	# Cage confines path writes, not aliases to an inode that already has a
	# name elsewhere. Be deliberately conservative: even multiple names wholly
	# inside these roots are refused rather than reconstructing inode topology.
	find "$HOME_DIR/work" "$HOME_DIR/state" -type f -links +1 -print -quit 2>/dev/null | grep -q .
}

check_home() {
	rc=0

	safe_file "$HOME_DIR/AGENTS.md" AGENTS.md || rc=1
	safe_file "$HOME_DIR/GOAL.md" GOAL.md || rc=1
	for name in SOUL.md PLAN.md HEARTBEAT.md MEMORY.md; do
		[ ! -e "$HOME_DIR/$name" ] || safe_file "$HOME_DIR/$name" "$name" || rc=1
	done
	for name in work state state/kv skills agents tools .agent .agent/runs .agent/learning; do
		safe_dir "$HOME_DIR/$name" "$name" || rc=1
	done
	safe_file "$HOME_DIR/bin/check" bin/check || rc=1
	[ -x "$HOME_DIR/bin/check" ] || { say "bin/check is not executable: $HOME_DIR/bin/check"; rc=1; }
	if [ -e "$HOME_DIR/bin/wake" ]; then
		safe_file "$HOME_DIR/bin/wake" bin/wake || rc=1
		[ -x "$HOME_DIR/bin/wake" ] || { say "bin/wake is not executable: $HOME_DIR/bin/wake"; rc=1; }
	elif [ -f "$HOME_DIR/HEARTBEAT.md" ] && nonempty_markdown "$HOME_DIR/HEARTBEAT.md"; then
		say "nonempty HEARTBEAT.md requires executable bin/wake: $HOME_DIR/bin/wake"
		rc=1
	fi

	[ "$rc" -eq 0 ] || return 1

	for name in work state state/kv skills agents tools .agent .agent/runs .agent/learning; do
		[ -r "$HOME_DIR/$name" ] && [ -x "$HOME_DIR/$name" ] || {
			say "$name is not readable/searchable: $HOME_DIR/$name"
			rc=1
		}
	done
	for name in work state state/kv .agent/runs .agent/learning; do
		[ -w "$HOME_DIR/$name" ] || {
			say "$name is not writable by the controller: $HOME_DIR/$name"
			rc=1
		}
	done
	for name in work/proposals work/actions .agent/amendments .agent/learning/proposals .agent/checkpoints .agent/selections; do
		if [ -e "$HOME_DIR/$name" ] || [ -L "$HOME_DIR/$name" ]; then
			safe_dir "$HOME_DIR/$name" "$name" || rc=1
			[ -w "$HOME_DIR/$name" ] || {
				say "$name is not writable by the controller: $HOME_DIR/$name"
				rc=1
			}
		fi
	done
	if has_unsafe_hardlinks; then
		say 'work/ or state/ contains a multiply-linked regular file; copy it to a fresh inode before running'
		rc=1
	fi
	if ! validate_tools; then
		rc=1
	fi

	if ! nonempty_markdown "$HOME_DIR/AGENTS.md"; then
		say 'AGENTS.md is empty'
		rc=1
	fi
	if ! nonempty_markdown "$HOME_DIR/GOAL.md"; then
		say 'GOAL.md is empty'
		rc=1
	fi

	total=0
	definition_files | while IFS= read -r name; do
		n=$(bytes "$HOME_DIR/$name")
		if [ "$n" -gt "$FILE_MAX" ]; then
			say "$name is $n bytes; the per-file limit is $FILE_MAX"
			exit 1
		fi
		total=$((total + n))
		if [ "$total" -gt "$CONTEXT_MAX" ]; then
			say "definition files total $total bytes; the limit is $CONTEXT_MAX"
			exit 1
		fi
	done || rc=1

	if ! validate_skills; then
		rc=1
	elif has_skills; then
		brief_bin=$(tool AGENT_BRIEF brief)
		if ! "$brief_bin" lint -strict "$HOME_DIR/skills"; then
			rc=1
		fi
	fi

	set -- "$HOME_DIR"/agents/*
	if [ -e "$1" ] || [ -L "$1" ]; then
		for child do
			if [ -L "$child" ]; then
				say "specialist home may not be a symlink: $child"
				rc=1
			elif [ ! -d "$child" ]; then
				say "agents/ entries must be nested agent homes: $child"
				rc=1
			elif ! (
				HOME_DIR=$(physical_dir "$child") || exit 1
				export HOME_DIR
				check_home
			); then
				rc=1
			fi
		done
	fi

	[ "$rc" -eq 0 ] || return 1
	say "$HOME_DIR is a valid agent home"
	return 0
}

write_context() {
	printf '# Agent home context\n\n'
	printf 'This context was compiled from `%s`. It is the governing agent definition and takes precedence over any earlier selected procedure when they conflict. Definition files are read-only during a confined run. Markdown shapes behavior but grants no authority.\n' "$HOME_DIR"
	context_files | while IFS= read -r name; do
		case $name in
			AGENTS.md) heading='Operating instructions (AGENTS.md)' ;;
			SOUL.md) heading='Character (SOUL.md)' ;;
			MEMORY.md) heading='Curated memory (MEMORY.md)' ;;
		esac
		printf '\n## %s\n\n' "$heading"
		cat "$HOME_DIR/$name"
		printf '\n'
	done

	printf '\n## Runtime paths\n\n'
	printf -- '- work: `%s`\n' "$HOME_DIR/work"
	printf -- '- durable state: `%s`\n' "$HOME_DIR/state"
	printf -- '- run evidence: `%s` (controller-owned)\n' "$HOME_DIR/.agent/runs"
	printf -- '- learning evidence: `%s` (controller-owned)\n' "$HOME_DIR/.agent/learning"
	printf -- '- reviewed learning proposals: `%s` (controller-owned)\n' "$HOME_DIR/.agent/learning/proposals"
	printf -- '- definition proposals: write patches under `%s`\n' "$HOME_DIR/work/proposals"
	if [ -d "$HOME_DIR/work/actions" ] && [ ! -L "$HOME_DIR/work/actions" ]; then
		printf -- '- external action proposals: write strict JSON under `%s`\n' "$HOME_DIR/work/actions"
		printf -- '  using `{\"version\":1,\"connector\":\"NAME\",\"input\":{...}}`; proposals do not grant authority and must be executed by the external controller with `agent act`\n'
	fi

	set -- "$HOME_DIR"/agents/*
	if [ -d "$1" ]; then
		printf '\n## Available specialist homes\n\n'
		for child do
			[ -d "$child" ] && [ ! -L "$child" ] || continue
			printf -- '- `%s`\n' "$child"
		done
		printf '\nSpecialists are separate agent runs. They do not inherit this conversation, loaded skills, check, or broader authority. Inside a confined action, report the exact specialist path and bounded task for an external controller; do not silently widen network or evidence writes to launch it.\n'
	fi
}

write_goal() {
	if [ "${RUN_KIND:-goal}" = tick ]; then
		printf '# Heartbeat goal\n\n'
		cat "$HOME_DIR/HEARTBEAT.md"
		if [ -n "${RUN_WAKE_OUTPUT:-}" ]; then
			printf '\n\n# Wake evidence\n\n%s\n' "$RUN_WAKE_OUTPUT"
		fi
	else
		printf '# Standing goal\n\n'
		cat "$HOME_DIR/GOAL.md"
		if [ -f "$HOME_DIR/PLAN.md" ] && nonempty_markdown "$HOME_DIR/PLAN.md"; then
			printf '\n\n# Standing plan\n\n'
			cat "$HOME_DIR/PLAN.md"
		fi
	fi
	if [ -n "${RUN_INPUT:-}" ]; then
		printf '\n\n# Invocation context\n\n%s\n' "$RUN_INPUT"
	fi
	if [ -n "${RUN_STDIN_FILE:-}" ] && [ -s "$RUN_STDIN_FILE" ]; then
		printf '\n\n# Piped input\n\n'
		cat "$RUN_STDIN_FILE"
		printf '\n'
	fi
}

# Keep the actual task distinct from evidence. Ply reads this bounded,
# operator-authored text through -goal-file for skill selection; plans, wake
# observations, and piped data remain stdin evidence that Ply can spool rather
# than promote into process argv or selector instructions.
write_run_task() {
	if [ "${RUN_KIND:-goal}" = tick ]; then
		cat "$HOME_DIR/HEARTBEAT.md"
	else
		cat "$HOME_DIR/GOAL.md"
	fi
	if [ -n "${RUN_INPUT:-}" ]; then
		printf '\n\nInvocation focus:\n%s\n' "$RUN_INPUT"
	fi
}

write_run_evidence() {
	if [ "${RUN_KIND:-goal}" = tick ]; then
		if [ -n "${RUN_WAKE_OUTPUT:-}" ]; then
			printf '# Wake evidence\n\n%s\n' "$RUN_WAKE_OUTPUT"
		fi
	elif [ -f "$HOME_DIR/PLAN.md" ] && nonempty_markdown "$HOME_DIR/PLAN.md"; then
		printf '# Standing plan\n\n'
		cat "$HOME_DIR/PLAN.md"
		printf '\n'
	fi
	if [ -n "${RUN_STDIN_FILE:-}" ] && [ -s "$RUN_STDIN_FILE" ]; then
		printf '\n# Piped input\n\n'
		cat "$RUN_STDIN_FILE"
		printf '\n'
	fi
}

compiled_hash() {
	{
		write_context
		printf '\n'
		write_goal
	} | hash_stream
}

new_home() {
	dir=${1:-}
	[ -n "$dir" ] || die 'new needs DIR'
	shift
	if [ -e "$dir" ]; then
		[ -d "$dir" ] || die "not a directory: $dir"
		[ -z "$(find "$dir" -mindepth 1 -maxdepth 1 -print -quit)" ] || die "directory is not empty: $dir"
	else
		mkdir -p "$dir" || die "cannot create $dir"
	fi
	desc=$*
	[ -n "$desc" ] || desc='Describe this agent'

	mkdir -p "$dir/bin" "$dir/work/proposals" "$dir/work/actions" "$dir/state/kv" "$dir/skills" "$dir/agents" "$dir/tools" "$dir/.agent/runs" "$dir/.agent/learning/proposals" "$dir/.agent/amendments" "$dir/.agent/checkpoints" "$dir/.agent/selections"
	cat >"$dir/AGENTS.md" <<EOF
# Operating instructions

$desc.

- Work toward the standing goal and respect its constraints.
- Keep current progress in state/plan.md; do not rewrite definition files.
- Put proposed definition changes under work/proposals/ for human review.
- Put proposed external effects under work/actions/ as strict Action JSON; never invoke a connector directly or claim a proposal happened.
- Inspect state on demand instead of loading it wholesale.
EOF
	cat >"$dir/GOAL.md" <<'EOF'
# Outcome

Replace this with the durable end state.

## Acceptance evidence

Explain what `bin/check` proves.

## Constraints and stop conditions

- Preserve anything that must not regress.
- Stop and report when human judgment or new authority is required.
EOF
	cat >"$dir/SOUL.md" <<'EOF'
# Character

Be calm, direct, curious, and evidence-led.
EOF
	cat >"$dir/PLAN.md" <<'EOF'
# Standing strategy

Start with the cheapest read-only observation that can change the plan.
EOF
	cat >"$dir/MEMORY.md" <<'EOF'
# Curated facts

Keep this small and human-reviewed. Verified procedures belong in skills/.
EOF
	: >"$dir/HEARTBEAT.md"
	: >"$dir/state/plan.md"
	cat >"$dir/bin/check" <<'EOF'
#!/bin/sh
# Replace with the executable definition of done. Exit 0 accepts, 1 rejects.
exit 1
EOF
	cat >"$dir/bin/wake" <<'EOF'
#!/bin/sh
# Replace when HEARTBEAT.md is used. Exit 0 is quiet, 1 wakes, other is broken.
exit 0
EOF
	chmod 700 "$dir/bin/check" "$dir/bin/wake"
	chmod 700 "$dir/.agent" "$dir/.agent/runs" "$dir/.agent/learning" "$dir/.agent/learning/proposals" "$dir/.agent/amendments" "$dir/.agent/checkpoints" "$dir/.agent/selections"
	printf '%s/AGENTS.md\n' "$dir"
	say "scaffolded $dir; edit GOAL.md and bin/check, then run agent check $dir"
}

open_home() {
	raw=${1:-.}
	HOME_DIR=$(physical_dir "$raw") || die "not an agent home directory: $raw"
	export HOME_DIR
}

show_home() {
	RUN_KIND=goal
	RUN_WAKE_OUTPUT=
	export RUN_KIND RUN_WAKE_OUTPUT
	if ! check_home >/dev/null; then
		return 1
	fi
	goal_compiled_hash=$(compiled_hash)
	printf 'agent-home: %s\n' "$HOME_DIR"
	printf 'definition-sha256: %s\n' "$(definition_hash)"
	printf 'compiled-sha256: %s\n' "$goal_compiled_hash"
	printf 'check-sha256: %s\n' "$(check_hash)"
	if [ -f "$HOME_DIR/bin/wake" ]; then
		printf 'wake-sha256: %s\n' "$(wake_hash)"
	fi
	printf 'workspace: %s\n' "$HOME_DIR/work"
	printf 'state: %s\n' "$HOME_DIR/state"
	printf 'toolbox: %s\n' "$HOME_DIR/tools"
	printf 'skills: %s\n' "$HOME_DIR/skills"
	printf 'check: %s\n' "$HOME_DIR/bin/check"
	printf 'evidence: %s\n' "$HOME_DIR/.agent/runs"
	printf 'selection-evidence: %s\n' "$HOME_DIR/.agent/selections/find"
	printf 'checkpoints: %s\n' "$HOME_DIR/.agent/checkpoints"
	printf 'learning-evidence: %s\n' "$HOME_DIR/.agent/learning"
	printf 'learning-proposals: %s\n' "$HOME_DIR/.agent/learning/proposals"
	printf 'amendment-evidence: %s\n' "$HOME_DIR/.agent/amendments"
	if [ -d "$HOME_DIR/work/actions" ]; then
		printf 'action-proposals: %s\n' "$HOME_DIR/work/actions"
	fi
	printf 'default-authority: full host tool catalogue; Cage writes work+state; network denied\n'
	printf '\n# Definition files\n\n'
	definition_files | while IFS= read -r name; do
		printf -- '- `%s` (%s bytes)\n' "$HOME_DIR/$name" "$(bytes "$HOME_DIR/$name")"
	done
	printf '\n'
	write_context
	printf '\n# Goal input\n\n'
	write_goal
	if [ -f "$HOME_DIR/HEARTBEAT.md" ] && nonempty_markdown "$HOME_DIR/HEARTBEAT.md"; then
		RUN_KIND=tick
		RUN_WAKE_OUTPUT=
		export RUN_KIND RUN_WAKE_OUTPUT
		printf '\n# Heartbeat input before wake evidence\n\n'
		write_goal
		printf '\nheartbeat-compiled-sha256: %s\n' "$(compiled_hash)"
		RUN_KIND=goal
		export RUN_KIND
	fi
	if has_skills; then
		printf '\n# Local skill catalogue\n\n'
		brief_bin=$(tool AGENT_BRIEF brief)
		BRIEF_PATH=$HOME_DIR/skills "$brief_bin" ls
	fi
}

quote_for_sh() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\"'\\\"'/g")"
}

run_home() {
	kind=$1
	shift
	net=0
	use_cage=1
	model=
	effort=
	checkpoint=
	quiet=0
	while [ "$#" -gt 0 ]; do
		case $1 in
			-net) net=1; shift ;;
			-no-cage) use_cage=0; shift ;;
			-m) [ "$#" -ge 2 ] || die '-m needs MODEL'; model=$2; shift 2 ;;
			-effort) [ "$#" -ge 2 ] || die '-effort needs NAME'; effort=$2; shift 2 ;;
			-checkpoint) [ "$#" -ge 2 ] || die '-checkpoint needs NAME'; checkpoint=$2; shift 2 ;;
			-q) quiet=1; shift ;;
			--) shift; break ;;
			-*) die "unknown run flag: $1" ;;
			*) break ;;
		esac
	done

	home=${FORCED_HOME:-.}
	if [ -z "${FORCED_HOME:-}" ] && [ "$#" -gt 0 ] && [ -d "$1" ]; then
		home=$1
		shift
	fi
	if [ "${1:-}" = -- ]; then shift; fi
	open_home "$home"
	if ! check_home; then
		return 1
	fi
	checkpoint_path=
	if [ -n "$checkpoint" ]; then
		checkpoint_name "$checkpoint" || die "checkpoint needs a portable name: $checkpoint"
		checkpoint_dir=$HOME_DIR/.agent/checkpoints
		if [ ! -e "$checkpoint_dir" ] && [ ! -L "$checkpoint_dir" ]; then
			mkdir "$checkpoint_dir" || die "cannot create checkpoint directory: $checkpoint_dir"
			chmod 700 "$checkpoint_dir"
		fi
		safe_dir "$checkpoint_dir" .agent/checkpoints || die 'invalid checkpoint directory'
		[ -w "$checkpoint_dir" ] || die "checkpoint directory is not writable: $checkpoint_dir"
		checkpoint_path=$checkpoint_dir/$checkpoint.current
		validate_checkpoint_in_home "$checkpoint_path"
	fi
	RUN_KIND=$kind
	RUN_WAKE_OUTPUT=
	if [ "$kind" = tick ]; then
		if [ ! -f "$HOME_DIR/HEARTBEAT.md" ] || ! nonempty_markdown "$HOME_DIR/HEARTBEAT.md"; then
			say 'heartbeat is empty; quiet'
			return 0
		fi
		set +e
		RUN_WAKE_OUTPUT=$(cd "$HOME_DIR/work" && "$HOME_DIR/bin/wake")
		wake_rc=$?
		set -e
		wake_bytes=$(printf '%s' "$RUN_WAKE_OUTPUT" | wc -c | tr -d '[:space:]')
		if [ "$wake_bytes" -gt "$FILE_MAX" ]; then
			say "bin/wake emitted $wake_bytes bytes; the limit is $FILE_MAX"
			return 2
		fi
		case $wake_rc in
			0) say 'wake check is quiet; no model call'; return 0 ;;
			1) say 'wake check found work; starting heartbeat run' ;;
			*) say "bin/wake is broken: exit $wake_rc"; return 2 ;;
		esac
	fi
	export RUN_KIND RUN_WAKE_OUTPUT

	ply_bin=$(tool AGENT_PLY ply)
	brief_bin=$(tool AGENT_BRIEF brief)
	ask_bin=$(tool AGENT_ASK ask)
	ply_capabilities=$("$ply_bin" capabilities) || die "cannot inspect Ply capabilities: $ply_bin"
	case $ply_capabilities in
		*'"schema":"ply.capabilities/v1"'*) ;;
		*) die "Ply is incompatible: $ply_bin does not report ply.capabilities/v1" ;;
	esac
	case $ply_capabilities in
		*'"goal_file":true'*) ;;
		*) die "Ply is incompatible: $ply_bin does not support goal_file" ;;
	esac
	case $ply_capabilities in
		*'"no_delegate":true'*) ;;
		*) die "Ply is incompatible: $ply_bin does not support no_delegate" ;;
	esac
	if [ "$use_cage" -eq 1 ]; then
		case $ply_capabilities in
			*'"action_boundary_receipt":"ply.action-boundary/v1"'*) ;;
			*) die "Ply is incompatible: $ply_bin does not support ply.action-boundary/v1" ;;
		esac
	fi
	model_effective=$model
	[ -n "$model_effective" ] || model_effective=${ASK_MODEL:-}
	action_shell=
	if [ "$use_cage" -eq 1 ]; then
		cage_bin=$(tool AGENT_CAGE cage)
		cage_bin=$(resolve_program "$cage_bin") || die "cannot resolve Cage executable: $cage_bin"
		find_bin=$(command -v find) || die 'find is required for the action boundary'
		find_bin=$(resolve_program "$find_bin") || die "cannot resolve find executable: $find_bin"
		case $cage_bin in
			"$HOME_DIR"|"$HOME_DIR"/*) die "Cage executable may not come from agent home: $cage_bin" ;;
		esac
		case $find_bin in
			"$HOME_DIR"|"$HOME_DIR"/*) die "find executable may not come from agent home: $find_bin" ;;
		esac
		agent_bin=$(resolve_program "$0") || die "cannot resolve agent executable: $0"
		action_shell=$(physical_dir "$(dirname "$agent_bin")")/agent-action-shell
		[ -x "$action_shell" ] || die "action shell is not executable: $action_shell"
		export AGENT_CAGE=$cage_bin AGENT_FIND=$find_bin AGENT_NET=$net
	else
		[ "$net" -eq 0 ] || die '-net has no meaning with -no-cage'
		say 'warning: Cage is disabled; model actions have ordinary host write and network reach'
	fi

	tmp_parent=$(physical_dir "${TMPDIR:-/tmp}") || die "temporary directory is not usable: ${TMPDIR:-/tmp}"
	case $tmp_parent in
		"$HOME_DIR"|"$HOME_DIR"/*) die "temporary directory must be outside agent home: $tmp_parent" ;;
	esac
	tmp=$(mktemp -d "$tmp_parent/agent-run.XXXXXX") || die 'cannot create private context directory'
	chmod 700 "$tmp"
	action_tmp=$tmp/action-tmp
	mkdir "$action_tmp"
	chmod 700 "$action_tmp"
	context_skill=$tmp/agent-context
	mkdir "$context_skill"
	goal_file=$tmp/goal.md
	run_task_file=$tmp/task.md
	RUN_STDIN_FILE=$tmp/stdin
	cleanup() {
		rm -rf "$tmp"
	}
	trap cleanup EXIT HUP INT TERM

	RUN_INPUT=$*
	if [ ! -t 0 ]; then
		head -c 16777217 >"$RUN_STDIN_FILE" || die 'cannot read piped input'
	else
		: >"$RUN_STDIN_FILE"
	fi
	run_stdin_bytes=$(bytes "$RUN_STDIN_FILE")
	[ "$run_stdin_bytes" -le "$INPUT_MAX" ] || die "piped input is $run_stdin_bytes bytes; the limit is $INPUT_MAX"
	export RUN_INPUT RUN_STDIN_FILE

	{
		printf '%s\n' '---'
		printf '%s\n' 'name: agent-context'
		printf '%s\n' 'description: Private compiled context for this exact agent home run.'
		printf '%s\n\n' '---'
		write_context
	} >"$context_skill/SKILL.md"
	write_run_evidence >"$goal_file"
	write_run_task >"$run_task_file"
	run_task_bytes=$(bytes "$run_task_file")
	[ "$run_task_bytes" -le "$CONTEXT_MAX" ] || die "run task is $run_task_bytes bytes; keep invocation text under the $CONTEXT_MAX-byte task limit and pipe large evidence instead"

	export AGENT_HOME=$HOME_DIR
	export AGENT_WORK=$HOME_DIR/work
	export AGENT_STATE=$HOME_DIR/state
	export AGENT_ACTION_TMP=$action_tmp
	if [ -z "${agent_bin:-}" ]; then
		agent_bin=$(resolve_program "$0") || die "cannot resolve agent executable: $0"
	fi
	export AGENT_BIN=$agent_bin
	export ASK=$ask_bin
	export BRIEF=$brief_bin
	export BRIEF_PATH=$HOME_DIR/skills
	export PLY_DIR=$HOME_DIR/.agent/runs
	selection_dir=$HOME_DIR/.agent/selections
	if [ ! -e "$selection_dir" ] && [ ! -L "$selection_dir" ]; then
		mkdir "$selection_dir" || die "cannot create skill-selection evidence directory: $selection_dir"
		chmod 700 "$selection_dir"
	fi
	safe_dir "$selection_dir" .agent/selections || die 'invalid skill-selection evidence directory'
	[ -w "$selection_dir" ] || die "skill-selection evidence directory is not writable: $selection_dir"
	export BRIEF_DIR=$selection_dir
	if [ -n "$model_effective" ]; then
		export BRIEF_MODEL=$model_effective
	else
		unset BRIEF_MODEL
	fi
	if [ -n "$effort" ]; then
		export BRIEF_EFFORT=$effort
	else
		unset BRIEF_EFFORT
	fi

	check_cmd=$(quote_for_sh "$HOME_DIR/bin/check")
	run_hash=$(compiled_hash)
	set -- -sh -shell /bin/sh -no-delegate -t "$HOME_DIR/tools" -C "$HOME_DIR/work" -check "$check_cmd" -goal-file "$run_task_file"
	if has_skills; then
		set -- "$@" -s -
	fi
	# The governing definition is appended after any selected procedure so a
	# skill cannot silently outrank AGENTS/SOUL/MEMORY by flag order.
	set -- "$@" -s "$context_skill"
	[ -z "$model_effective" ] || set -- "$@" -m "$model_effective"
	set -- "$@" -effort "$effort"
	[ -z "$checkpoint_path" ] || set -- "$@" -checkpoint "$checkpoint_path"
	[ "$quiet" -eq 0 ] || set -- "$@" -q
	if [ -n "$action_shell" ]; then
		set -- "$@" -action-shell "$action_shell" -action-boundary-exit 125
	else
		set -- "$@" -action-shell /bin/sh
	fi

	say "run $run_hash · check=$(check_hash) · work=$HOME_DIR/work · evidence=$HOME_DIR/.agent/runs${checkpoint:+ · checkpoint=$checkpoint}"
	if [ "$use_cage" -eq 1 ]; then
		if [ "$net" -eq 1 ]; then
			say 'authority: Cage writes work+state; network allowed by caller'
		else
			say 'authority: Cage writes work+state; network denied'
		fi
	fi

	# The compiled goal is now a regular stdin file. Do not leak caller input,
	# piped-input paths, or wake evidence through Ply's inherited environment.
	unset RUN_KIND RUN_WAKE_OUTPUT RUN_INPUT RUN_STDIN_FILE AGENT_MAY BENCH_MAY \
		AGENT_ACTION AGENT_ACTION_PATH AGENT_ACTION_POLICY ACTION_PATH ACTION_POLICY ACTION_MAY ACTION_ASK
	# Agent owns this Ply root invocation. Ambient composition knobs must not
	# replace its interpreter, depth, contract, effort, or approval boundary.
	unset PLY_TOOLS PLY_SHELL PLY_ACTION_SHELL PLY_EFFORT PLY_CONTRACT_ID PLY_MAY_JOB PLY_DEPTH MAY ASK_MODEL ASK_SYSTEM ASK_DIR

	set +e
	"$ply_bin" "$@" <"$goal_file"
	rc=$?
	set -e
	return "$rc"
}

portable_name() {
	case $1 in
		''|*[!a-z0-9-]*|-*|*-) return 1 ;;
		[a-z]*) return 0 ;;
		*) return 1 ;;
	esac
}

checkpoint_name() {
	[ "${#1}" -le 64 ] && portable_name "$1"
}

validate_checkpoint_in_home() {
	checkpoint_file=$1
	[ ! -L "$checkpoint_file" ] || die "checkpoint may not be a symlink: $checkpoint_file"
	[ -e "$checkpoint_file" ] || return 0
	safe_file "$checkpoint_file" checkpoint || die "invalid checkpoint: $checkpoint_file"
	checkpoint_size=$(bytes "$checkpoint_file")
	[ "$checkpoint_size" -gt 0 ] && [ "$checkpoint_size" -le 16384 ] || die "checkpoint has invalid size: $checkpoint_file"
	checkpoint_session=
	IFS= read -r checkpoint_session <"$checkpoint_file" || die "checkpoint is not newline terminated: $checkpoint_file"
	checkpoint_cr=$(printf '\r')
	case $checkpoint_session in
		''|*"$checkpoint_cr"*) die "checkpoint must contain one session path: $checkpoint_file" ;;
	esac
	checkpoint_line_size=$(printf '%s\n' "$checkpoint_session" | wc -c | tr -d '[:space:]')
	[ "$checkpoint_line_size" -eq "$checkpoint_size" ] || die "checkpoint must contain one session path: $checkpoint_file"
	checkpoint_parent=$(physical_dir "$(dirname "$checkpoint_session")") || die "checkpoint session directory not found: $checkpoint_session"
	checkpoint_session=$checkpoint_parent/$(basename "$checkpoint_session")
	case $checkpoint_session in
		"$HOME_DIR/.agent/runs/"*) ;;
		*) die "checkpoint session is outside this home's run evidence: $checkpoint_session" ;;
	esac
	[ ! -L "$checkpoint_session" ] || die "checkpoint session may not be a symlink: $checkpoint_session"
	[ ! -e "$checkpoint_session" ] || safe_file "$checkpoint_session" session || die "invalid checkpoint session: $checkpoint_session"
}

specialist_home() {
	specialist_parent=${1:-}
	specialist_name=${2:-}
	[ -n "$specialist_parent" ] && [ -n "$specialist_name" ] || die 'specialist needs PARENT and NAME'
	portable_name "$specialist_name" || die "specialist name is not portable: $specialist_name"
	shift 2

	open_home "$specialist_parent"
	if ! check_home; then
		return 1
	fi
	specialist_child=$HOME_DIR/agents/$specialist_name
	[ ! -L "$specialist_child" ] || die "specialist home may not be a symlink: $specialist_child"
	specialist_child=$(physical_dir "$specialist_child") || die "specialist home not found: $specialist_name"
	say "specialist $specialist_name · parent=$HOME_DIR · evidence=$specialist_child/.agent/runs"
	FORCED_HOME=$specialist_child
	run_home goal "$@"
}

session_in_home() {
	raw=$1
	case $raw in
		*/*) candidate=$raw ;;
		*)
			candidate=$HOME_DIR/.agent/runs/$raw
			[ -e "$candidate" ] || candidate=$candidate.jsonl
			;;
	esac
	[ ! -L "$candidate" ] || die "session may not be a symlink: $candidate"
	parent=$(physical_dir "$(dirname "$candidate")") || die "session directory not found: $candidate"
	SESSION_FILE=$parent/$(basename "$candidate")
	case $SESSION_FILE in
		"$HOME_DIR/.agent/runs/"*) ;;
		*) die "session is outside this home's run evidence: $SESSION_FILE" ;;
	esac
	safe_file "$SESSION_FILE" session || die "invalid session: $SESSION_FILE"
	export SESSION_FILE
}

action_proposal_in_home() {
	raw=$1
	proposal_root=$HOME_DIR/work/actions
	safe_dir "$proposal_root" work/actions || die "invalid action proposal directory: $proposal_root"
	case $raw in
		*/*) candidate=$raw ;;
		*) candidate=$proposal_root/$raw ;;
	esac
	[ ! -L "$candidate" ] || die "action proposal may not be a symlink: $candidate"
	parent=$(physical_dir "$(dirname "$candidate")") || die "action proposal directory not found: $candidate"
	ACTION_PROPOSAL_FILE=$parent/$(basename "$candidate")
	[ "$parent" = "$(physical_dir "$proposal_root")" ] || die "action proposal is outside this home's work/actions: $ACTION_PROPOSAL_FILE"
	proposal_name=$(basename "$ACTION_PROPOSAL_FILE")
	case $proposal_name in
		''|.*|*[!A-Za-z0-9._-]*) die "action proposal needs a portable .json filename: $proposal_name" ;;
		*.json) ;;
		*) die "action proposal needs a portable .json filename: $proposal_name" ;;
	esac
	safe_file "$ACTION_PROPOSAL_FILE" 'action proposal' || die "invalid action proposal: $ACTION_PROPOSAL_FILE"
	if find "$ACTION_PROPOSAL_FILE" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
		die "action proposal is multiply linked: $ACTION_PROPOSAL_FILE"
	fi
	proposal_bytes=$(bytes "$ACTION_PROPOSAL_FILE")
	[ "$proposal_bytes" -le "$FILE_MAX" ] || die "action proposal is $proposal_bytes bytes; the limit is $FILE_MAX"
	export ACTION_PROPOSAL_FILE
}

print_action_review() {
	action_bin=$1
	proposal_hash=$(hash_file "$ACTION_PROPOSAL_FILE")
	printf '%s\n' 'agent-action-proposal/v1'
	printf 'home: %s\n' "$HOME_DIR"
	printf 'definition-sha256: %s\n' "$(definition_hash)"
	printf 'proposal: %s\n' "$ACTION_PROPOSAL_FILE"
	printf 'proposal-sha256: %s\n' "$proposal_hash"
	printf 'proposal-bytes: %s\n' "$(bytes "$ACTION_PROPOSAL_FILE")"
	printf 'may-job: agent-action-%s-%s\n' "$(definition_hash)" "$proposal_hash"
	printf '%s\n' 'canonical-proposal:'
	"$action_bin" inspect "$ACTION_PROPOSAL_FILE"
}

actions_home() {
	[ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'actions needs HOME and optional PROPOSAL'
	open_home "$1"
	if ! check_home >/dev/null; then
		return 1
	fi
	action_bin=$(tool AGENT_ACTION action)
	if [ "$#" -eq 2 ]; then
		action_proposal_in_home "$2"
		print_action_review "$action_bin"
		return 0
	fi

	proposal_root=$HOME_DIR/work/actions
	safe_dir "$proposal_root" work/actions || die "invalid action proposal directory: $proposal_root"
	set -- "$proposal_root"/*.json
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		printf 'agent-actions/v1\nhome: %s\ndefinition-sha256: %s\ncount: 0\n' "$HOME_DIR" "$(definition_hash)"
		return 0
	fi
	[ "$#" -le "$PROPOSAL_MAX" ] || die "action proposal catalogue has $# files; the limit is $PROPOSAL_MAX"
	proposal_total=0
	printf 'agent-actions/v1\nhome: %s\ndefinition-sha256: %s\ncount: %s\n' "$HOME_DIR" "$(definition_hash)" "$#"
	for proposal_path do
		action_proposal_in_home "$proposal_path"
		proposal_total=$((proposal_total + $(bytes "$ACTION_PROPOSAL_FILE")))
		[ "$proposal_total" -le "$CONTEXT_MAX" ] || die "action proposal bytes total $proposal_total; the limit is $CONTEXT_MAX"
		printf '\n'
		print_action_review "$action_bin"
	done
}

act_home() {
	policy=${AGENT_ACTION_POLICY:-}
	while [ "$#" -gt 0 ]; do
		case $1 in
			-policy) [ "$#" -ge 2 ] || die '-policy needs PROGRAM'; policy=$2; shift 2 ;;
			-*) die "unknown act flag: $1" ;;
			*) break ;;
		esac
	done
	[ "$#" -eq 3 ] || die 'act needs HOME PROPOSAL SESSION'
	open_home "$1"
	if ! check_home; then
		return 1
	fi
	action_proposal_in_home "$2"
	session_in_home "$3"
	action_path=${AGENT_ACTION_PATH:-}
	[ -n "$action_path" ] || die 'act needs AGENT_ACTION_PATH naming controller-only Action connectors'
	action_bin=$(tool AGENT_ACTION action)
	may_bin=$(tool AGENT_MAY may)
	ask_bin=$(tool AGENT_ASK ask)
	proposal_hash=$(hash_file "$ACTION_PROPOSAL_FILE")
	job=agent-action-$(definition_hash)-$proposal_hash
	say "action · home=$HOME_DIR · proposal=$ACTION_PROPOSAL_FILE · evidence=$SESSION_FILE"
	set -- run -job "$job" -may "$may_bin" -ask "$ask_bin" -record "$SESSION_FILE" -proposal "$ACTION_PROPOSAL_FILE"
	[ -z "$policy" ] || set -- "$@" -policy "$policy"
	set +e
	(cd "$HOME_DIR/work" && ACTION_PATH=$action_path "$action_bin" "$@")
	rc=$?
	set -e
	return "$rc"
}

learning_proposal_file() {
	proposal_name=$1
	proposal_mode=$2
	case $proposal_name in
		''|.*|*/*|*[!a-z0-9._-]*) die "learning proposal needs a portable .json filename: $proposal_name" ;;
		*.json) ;;
		*) die "learning proposal needs a portable .json filename: $proposal_name" ;;
	esac
	proposal_root=$HOME_DIR/.agent/learning/proposals
	if [ "$proposal_mode" = create ] && [ ! -e "$proposal_root" ] && [ ! -L "$proposal_root" ]; then
		mkdir "$proposal_root" || die "cannot create learning proposal directory: $proposal_root"
		chmod 700 "$proposal_root"
	fi
	safe_dir "$proposal_root" .agent/learning/proposals || die "invalid learning proposal directory: $proposal_root"
	[ -r "$proposal_root" ] && [ -w "$proposal_root" ] && [ -x "$proposal_root" ] ||
		die "learning proposal directory is not accessible and writable: $proposal_root"
	LEARNING_PROPOSAL_FILE=$proposal_root/$proposal_name
	[ ! -L "$LEARNING_PROPOSAL_FILE" ] || die "learning proposal may not be a symlink: $LEARNING_PROPOSAL_FILE"
	if [ "$proposal_mode" = read ]; then
		safe_file "$LEARNING_PROPOSAL_FILE" 'learning proposal' || die "invalid learning proposal: $LEARNING_PROPOSAL_FILE"
		if find "$LEARNING_PROPOSAL_FILE" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
			die "learning proposal is multiply linked: $LEARNING_PROPOSAL_FILE"
		fi
	elif [ -e "$LEARNING_PROPOSAL_FILE" ]; then
		die "learning proposal already exists: $LEARNING_PROPOSAL_FILE"
	fi
	export LEARNING_PROPOSAL_FILE
}

learn_home() {
	into=
	model=
	count=
	dry=0
	why=0
	quiet=0
	prepare=
	show=
	admit=
	while [ "$#" -gt 0 ]; do
		case $1 in
			-into) [ "$#" -ge 2 ] || die '-into needs SKILL'; into=$2; shift 2 ;;
			-m) [ "$#" -ge 2 ] || die '-m needs MODEL'; model=$2; shift 2 ;;
			-n) [ "$#" -ge 2 ] || die '-n needs COUNT'; count=$2; shift 2 ;;
			-N) dry=1; shift ;;
			-why) why=1; shift ;;
			-prepare) [ "$#" -ge 2 ] || die '-prepare needs PROPOSAL'; prepare=$2; shift 2 ;;
			-show) [ "$#" -ge 2 ] || die '-show needs PROPOSAL'; show=$2; shift 2 ;;
			-admit) [ "$#" -ge 2 ] || die '-admit needs PROPOSAL'; admit=$2; shift 2 ;;
			-q) quiet=1; shift ;;
			-*) die "unknown learn flag: $1" ;;
			*) break ;;
		esac
	done
	modes=0
	[ -z "$prepare" ] || modes=$((modes + 1))
	[ -z "$show" ] || modes=$((modes + 1))
	[ -z "$admit" ] || modes=$((modes + 1))
	[ "$modes" -le 1 ] || die 'learn accepts only one of -prepare, -show, or -admit'
	if [ -n "$prepare" ] && { [ "$dry" -ne 0 ] || [ "$why" -ne 0 ]; }; then
		die 'learn -prepare cannot be combined with -N or -why'
	fi

	if [ -n "$show" ] || [ -n "$admit" ]; then
		[ -z "$into$model$count" ] && [ "$dry" -eq 0 ] && [ "$why" -eq 0 ] && [ "$quiet" -eq 0 ] ||
			die 'learn -show/-admit do not accept wording flags or -into'
		[ "$#" -eq 1 ] || die 'learn -show/-admit need HOME and no SESSION'
		open_home "$1"
		if ! check_home; then
			return 1
		fi
		proposal_name=$show
		operation=show
		if [ -n "$admit" ]; then
			proposal_name=$admit
			operation=admit
		fi
		learning_proposal_file "$proposal_name" read
		hone_bin=$(tool AGENT_HONE hone)
		export HONE_DIR=$HOME_DIR/.agent/learning
		if [ "$operation" = admit ]; then
			[ -w "$HOME_DIR/skills" ] || die "skills directory is not writable by the controller: $HOME_DIR/skills"
			ask_bin=$(tool AGENT_ASK ask)
			brief_bin=$(tool AGENT_BRIEF brief)
			export ASK=$ask_bin
			export BRIEF=$brief_bin
			export BRIEF_PATH=$HOME_DIR/skills
		fi
		say "learn $operation · proposal=$LEARNING_PROPOSAL_FILE · skill-root=$HOME_DIR/skills"
		set +e
		"$hone_bin" "$operation" "$LEARNING_PROPOSAL_FILE"
		rc=$?
		set -e
		return "$rc"
	fi

	[ -n "$into" ] || die 'learn requires -into SKILL'
	portable_name "$into" || die "learning skill name is not portable: $into"
	[ "$#" -eq 2 ] || die 'learn needs HOME and SESSION'
	open_home "$1"
	if ! check_home; then
		return 1
	fi
	session_in_home "$2"
	[ -w "$HOME_DIR/skills" ] || die "skills directory is not writable by the controller: $HOME_DIR/skills"

	hone_bin=$(tool AGENT_HONE hone)
	brief_bin=$(tool AGENT_BRIEF brief)
	ask_bin=$(tool AGENT_ASK ask)
	export ASK=$ask_bin
	export BRIEF=$brief_bin
	export BRIEF_PATH=$HOME_DIR/skills
	export HONE_DIR=$HOME_DIR/.agent/learning
	set -- -into "$into"
	[ -z "$model" ] || set -- "$@" -m "$model"
	[ -z "$count" ] || set -- "$@" -n "$count"
	[ "$dry" -eq 0 ] || set -- "$@" -N
	[ "$why" -eq 0 ] || set -- "$@" -why
	if [ -n "$prepare" ]; then
		learning_proposal_file "$prepare" create
		set -- "$@" -prepare "$LEARNING_PROPOSAL_FILE"
	fi
	[ "$quiet" -eq 0 ] || set -- "$@" -q
	set -- "$@" "$SESSION_FILE"
	say "learn · session=$SESSION_FILE · skill=$HOME_DIR/skills/$into · evidence=$HOME_DIR/.agent/learning${prepare:+ · proposal=$LEARNING_PROPOSAL_FILE}"
	set +e
	"$hone_bin" "$@"
	rc=$?
	set -e
	return "$rc"
}

history_home() {
	[ "$#" -ge 1 ] || die 'history needs HOME'
	open_home "$1"
	shift
	if ! check_home >/dev/null; then
		return 1
	fi

	trail_bin=$(tool AGENT_TRAIL trail)
	archive=$HOME_DIR/.agent/runs
	history_command=${1:-ls}
	[ "$#" -eq 0 ] || shift
	case $history_command in
		ls)
			[ "$#" -eq 0 ] || die 'history ls takes no arguments'
			set -- ls "$archive"
			;;
		find)
			[ "$#" -eq 1 ] || die 'history find needs one quoted QUERY'
			[ -n "$1" ] || die 'history find query is empty'
			set -- find "$1" "$archive"
			;;
		show)
			[ "$#" -eq 1 ] || die 'history show needs SESSION'
			session_in_home "$1"
			set -- show "$SESSION_FILE"
			;;
		window)
			before=
			after=
			while [ "$#" -gt 0 ]; do
				case $1 in
					-before|-after)
						flag=$1
						[ "$#" -ge 2 ] || die "history window $flag needs N"
						case $2 in ''|*[!0-9]*) die "history window $flag must be a non-negative integer" ;; esac
						if [ "$flag" = -before ]; then before=$2; else after=$2; fi
						shift 2
						;;
					-*) die "unknown history window flag: $1" ;;
					*) break ;;
				esac
			done
			[ "$#" -eq 2 ] || die 'history window needs SESSION and SEQ'
			session_in_home "$1"
			seq=$2
			case $seq in ''|*[!0-9]*) die 'history window SEQ must be a positive integer' ;; esac
			[ "$seq" -gt 0 ] || die 'history window SEQ must be a positive integer'
			set -- window
			[ -z "$before" ] || set -- "$@" -before "$before"
			[ -z "$after" ] || set -- "$@" -after "$after"
			set -- "$@" "$SESSION_FILE" "$seq"
			;;
		lineage)
			[ "$#" -eq 1 ] || die 'history lineage needs SESSION'
			session_in_home "$1"
			set -- lineage "$SESSION_FILE" "$archive"
			;;
		check)
			[ "$#" -eq 0 ] || die 'history check takes no arguments'
			ask_bin=$(tool AGENT_ASK ask)
			export ASK=$ask_bin
			set -- check "$archive"
			;;
		*) die "unknown history command: $history_command" ;;
	esac
	say "history · home=$HOME_DIR · evidence=$archive · command=$history_command"
	set +e
	"$trail_bin" "$@"
	rc=$?
	set -e
	return "$rc"
}

proposal_in_home() {
	raw=$1
	proposal_root=$HOME_DIR/work/proposals
	safe_dir "$proposal_root" work/proposals || die "invalid proposal directory: $proposal_root"
	case $raw in
		*/*) candidate=$raw ;;
		*) candidate=$proposal_root/$raw ;;
	esac
	[ ! -L "$candidate" ] || die "proposal may not be a symlink: $candidate"
	parent=$(physical_dir "$(dirname "$candidate")") || die "proposal directory not found: $candidate"
	PROPOSAL_FILE=$parent/$(basename "$candidate")
	[ "$parent" = "$(physical_dir "$proposal_root")" ] || die "proposal is outside this home's work/proposals: $PROPOSAL_FILE"
	proposal_name=$(basename "$PROPOSAL_FILE")
	case $proposal_name in
		''|.*|*[!A-Za-z0-9._-]*) die "proposal needs a portable .patch filename: $proposal_name" ;;
		*.patch) ;;
		*) die "proposal needs a portable .patch filename: $proposal_name" ;;
	esac
	safe_file "$PROPOSAL_FILE" proposal || die "invalid proposal: $PROPOSAL_FILE"
	proposal_bytes=$(bytes "$PROPOSAL_FILE")
	[ "$proposal_bytes" -le "$FILE_MAX" ] || die "proposal is $proposal_bytes bytes; the limit is $FILE_MAX"
	export PROPOSAL_FILE
}

inspect_amendment() {
	command -v git >/dev/null 2>&1 || die 'amend needs git for strict patch parsing and application'

	stats=$(cd "$HOME_DIR" && git apply --numstat "$PROPOSAL_FILE") || die 'proposal is not a parseable patch'
	[ "$(printf '%s\n' "$stats" | sed '/^$/d' | wc -l | tr -d '[:space:]')" -eq 1 ] || die 'amend accepts exactly one definition file per proposal'
	AMEND_TARGET=$(printf '%s\n' "$stats" | awk -F '\t' 'NF == 3 { print $3 }')
	case $AMEND_TARGET in
		AGENTS.md|GOAL.md|SOUL.md|PLAN.md|HEARTBEAT.md|MEMORY.md) ;;
		*) die "amend target is not a supported root definition file: $AMEND_TARGET" ;;
	esac
	[ ! -L "$HOME_DIR/$AMEND_TARGET" ] || die "amend target may not be a symlink: $AMEND_TARGET"
	safe_file "$HOME_DIR/$AMEND_TARGET" 'amend target' || die "invalid amend target: $AMEND_TARGET"
	if find "$HOME_DIR/$AMEND_TARGET" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
		die "amend target is multiply linked: $AMEND_TARGET"
	fi
	(cd "$HOME_DIR" && git apply --check "$PROPOSAL_FILE") || die 'proposal does not apply cleanly to the current definition'

	AMEND_BEFORE_HASH=$(definition_hash)
	AMEND_PROPOSAL_HASH=$(hash_file "$PROPOSAL_FILE")
	AMEND_JOB=agent-amend-$AMEND_BEFORE_HASH-$AMEND_PROPOSAL_HASH
	AMEND_ACTION=$(printf '%s\n' \
		'agent-amend/v1' \
		"home: $HOME_DIR" \
		"definition-sha256: $AMEND_BEFORE_HASH" \
		"target: $AMEND_TARGET" \
		"proposal: $PROPOSAL_FILE" \
		"proposal-sha256: $AMEND_PROPOSAL_HASH" \
		'effect: apply this one root definition-file patch, then require agent check')
}

print_proposal_review() {
	inspect_amendment
	printf '%s\n' 'agent-proposal/v1'
	printf 'home: %s\n' "$HOME_DIR"
	printf 'definition-sha256: %s\n' "$AMEND_BEFORE_HASH"
	printf 'proposal: %s\n' "$PROPOSAL_FILE"
	printf 'proposal-sha256: %s\n' "$AMEND_PROPOSAL_HASH"
	printf 'proposal-bytes: %s\n' "$(bytes "$PROPOSAL_FILE")"
	printf 'target: %s\n' "$AMEND_TARGET"
	printf 'may-job: %s\n' "$AMEND_JOB"
	printf 'may-action-sha256: %s\n' "$(printf '%s\n' "$AMEND_ACTION" | hash_stream)"
	printf 'may-action (one final LF is included):\n%s\n' "$AMEND_ACTION"
	printf '%s\n' 'patch-bytes:'
	cat "$PROPOSAL_FILE"
	printf '\n'
}

proposals_home() {
	[ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'proposals needs HOME and optional PATCH'
	open_home "$1"
	if ! check_home >/dev/null; then
		return 1
	fi
	if [ "$#" -eq 2 ]; then
		proposal_in_home "$2"
		print_proposal_review
		return 0
	fi

	proposal_root=$HOME_DIR/work/proposals
	safe_dir "$proposal_root" work/proposals || die "invalid proposal directory: $proposal_root"
	set -- "$proposal_root"/*.patch
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		printf 'agent-proposals/v1\nhome: %s\ndefinition-sha256: %s\ncount: 0\n' "$HOME_DIR" "$(definition_hash)"
		return 0
	fi
	[ "$#" -le "$PROPOSAL_MAX" ] || die "proposal catalogue has $# patches; the limit is $PROPOSAL_MAX"
	proposal_total=0
	printf 'agent-proposals/v1\nhome: %s\ndefinition-sha256: %s\ncount: %s\n' "$HOME_DIR" "$(definition_hash)" "$#"
	for proposal_path do
		proposal_in_home "$proposal_path"
		proposal_total=$((proposal_total + $(bytes "$PROPOSAL_FILE")))
		[ "$proposal_total" -le "$CONTEXT_MAX" ] || die "proposal bytes total $proposal_total; the limit is $CONTEXT_MAX"
		printf '\n'
		print_proposal_review
	done
}

amend_home() {
	[ "$#" -eq 2 ] || die 'amend needs HOME and PATCH'
	open_home "$1"
	if ! check_home; then
		return 1
	fi
	proposal_in_home "$2"
	inspect_amendment
	target=$AMEND_TARGET
	before_hash=$AMEND_BEFORE_HASH
	proposal_hash=$AMEND_PROPOSAL_HASH
	job=$AMEND_JOB
	action=$AMEND_ACTION

	receipt_dir=$HOME_DIR/.agent/amendments
	if [ ! -e "$receipt_dir" ]; then
		mkdir "$receipt_dir" || die "cannot create amendment evidence: $receipt_dir"
		chmod 700 "$receipt_dir"
	fi
	safe_dir "$receipt_dir" .agent/amendments || die "invalid amendment evidence directory: $receipt_dir"
	[ -r "$receipt_dir" ] && [ -w "$receipt_dir" ] && [ -x "$receipt_dir" ] ||
		die "amendment evidence is not accessible and writable: $receipt_dir"

	may_bin=$(tool AGENT_MAY may)
	set +e
	may_result=$(printf '%s\n' "$action" | "$may_bin" request "$job")
	may_status=$?
	set -e
	[ -z "$may_result" ] || printf '%s\n' "$may_result"
	[ "$may_status" -eq 0 ] || return "$may_status"

	[ "$(definition_hash)" = "$before_hash" ] || die 'definition changed after approval was requested; refusing stale grant'
	[ "$(hash_file "$PROPOSAL_FILE")" = "$proposal_hash" ] || die 'proposal changed after approval was requested; refusing stale grant'
	(cd "$HOME_DIR" && git apply --check "$PROPOSAL_FILE") || die 'proposal no longer applies cleanly after approval'

	tmp_parent=${TMPDIR:-/tmp}
	backup_dir=$(mktemp -d "$tmp_parent/agent-amend.XXXXXX") || die 'cannot create amendment backup'
	receipt_tmp=$(mktemp "$receipt_dir/.receipt.XXXXXX") || {
		rm -rf "$backup_dir"
		die 'cannot stage amendment receipt'
	}
	applied=0
	committed=0
	cleanup_amend() {
		if [ "$applied" -eq 1 ] && [ "$committed" -eq 0 ]; then
			cp -p "$backup_dir/$target" "$HOME_DIR/$target" 2>/dev/null || :
		fi
		rm -f "$receipt_tmp"
		rm -rf "$backup_dir"
	}
	trap cleanup_amend EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	chmod 600 "$receipt_tmp"
	cp -p "$HOME_DIR/$target" "$backup_dir/$target" || die 'cannot back up amendment target'
	if ! (cd "$HOME_DIR" && git apply "$PROPOSAL_FILE"); then
		die 'approved proposal could not be applied'
	fi
	applied=1
	if ! check_home; then
		cp -p "$backup_dir/$target" "$HOME_DIR/$target" || die 'amendment invalid and rollback failed'
		applied=0
		say 'approved amendment failed agent check and was rolled back'
		return 2
	fi
	after_hash=$(definition_hash)
	{
		printf '%s\n' 'agent-amend/v1'
		printf 'home: %s\n' "$HOME_DIR"
		printf 'target: %s\n' "$target"
		printf 'proposal: %s\n' "$PROPOSAL_FILE"
		printf 'proposal-sha256: %s\n' "$proposal_hash"
		printf 'definition-before-sha256: %s\n' "$before_hash"
		printf 'definition-after-sha256: %s\n' "$after_hash"
		printf 'may-result: %s\n' "$may_result"
	} >"$receipt_tmp"
	receipt=$receipt_dir/$proposal_hash.txt
	mv "$receipt_tmp" "$receipt" || die 'cannot publish amendment receipt'
	committed=1
	say "amended $target · before=$before_hash · after=$after_hash · evidence=$receipt"
}

cmd=${1:-help}
case $cmd in
	help|-h|--help)
		usage
		;;
	version|-V|--version)
		printf '%s %s\n' "$ME" "$VERSION"
		;;
	new)
		shift
		new_home "$@"
		;;
	check)
		shift
		open_home "${1:-.}"
		if check_home; then exit 0; else exit 1; fi
		;;
	show)
		shift
		open_home "${1:-.}"
		show_home
		;;
	run)
		shift
		run_home goal "$@"
		;;
	tick)
		shift
		run_home tick "$@"
		;;
	specialist)
		shift
		specialist_home "$@"
		;;
	learn)
		shift
		learn_home "$@"
		;;
	history)
		shift
		history_home "$@"
		;;
	actions)
		shift
		actions_home "$@"
		;;
	act)
		shift
		act_home "$@"
		;;
	proposals)
		shift
		proposals_home "$@"
		;;
	amend)
		shift
		amend_home "$@"
		;;
	*)
		die "unknown command: $cmd (run agent help)"
		;;
esac
