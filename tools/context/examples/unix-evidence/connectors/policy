#!/usr/bin/env python3
"""Offline document adapter for a fictional export policy."""

import json
import sys
from datetime import datetime, timezone


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("describe", "query"):
        print("usage: policy describe|query", file=sys.stderr)
        return 2
    if sys.argv[1] == "describe":
        print(json.dumps({"kind": "source", "version": 1, "name": "policy",
                          "description": "Fictional customer export policy",
                          "types": ["document"]}))
        return 0
    query = sys.stdin.read()
    if "export" not in query.lower():
        return 1
    print(json.dumps({
        "kind": "context", "version": 1, "source": "policy",
        "type": "document", "id": "demo/export-policy@1",
        "title": "Demo export policy",
        "retrieved_at": datetime.now(timezone.utc).isoformat(),
        "content": {
            "text": "Customers may export data when export_enabled is true.",
            "required_entitlement": "export_enabled",
        },
        "citation": {"locator": "demo/export-policy@1",
                     "url": "https://example.com/demo/export-policy?revision=1"},
        "origin": {"instance": "demo", "revision": "1"},
        "coverage": {"scope": "this document revision", "truncated": False},
    }))
    return 0


raise SystemExit(main())
