#!/usr/bin/env python3
"""Identity filter enforcing only this fixture's evidence requirements."""

import json
import subprocess
import sys


def main():
    raw = sys.stdin.buffer.read((32 << 20) + 1)
    validation = subprocess.run(["context", "check"], input=raw,
                                stdout=subprocess.PIPE, check=False)
    if validation.returncode:
        return validation.returncode if validation.returncode in (1, 2) else 2
    records = [json.loads(line) for line in raw.splitlines()]
    if len(records) != 2 or {row["source"] for row in records} != {"policy", "entitlements"}:
        print("check-evidence: require one policy and one entitlement record", file=sys.stderr)
        return 1
    for row in records:
        if row.get("origin") != {"instance": "demo", "revision": "1"}:
            print("check-evidence: require the configured demo revision", file=sys.stderr)
            return 1
        coverage = row.get("coverage")
        scope = "this document revision" if row["source"] == "policy" else "this executed query"
        if not isinstance(coverage, dict) or coverage.get("scope") != scope or coverage.get("truncated") is not False:
            print("check-evidence: evidence is truncated or its scope/completeness is unknown", file=sys.stderr)
            return 1
    sys.stdout.buffer.write(raw)
    return 0


try:
    raise SystemExit(main())
except (OSError, ValueError, KeyError, TypeError) as exc:
    print("check-evidence: " + str(exc), file=sys.stderr)
    raise SystemExit(2)
