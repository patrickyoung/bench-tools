#!/usr/bin/env python3
# mcpbox - turn an MCP server's tools into a ply toolbox, one program each
#
# An MCP server is a tool cabinet and a bridge CLI is the key; ply never
# learns the protocol, exactly as mu never did. What ply adds is that a
# blessing can be enforced rather than advised: a tool the model may call
# is a program in the toolbox, and -t makes $PATH that directory alone.
#
# tools/list already carries the three things a toolbox wants -- a name, a
# sentence, and a schema -- so the manifest is a directory listing waiting
# to happen:
#
#     mcpbox tools/ npx -y @modelcontextprotocol/server-everything
#     rm tools/get-env tools/print-env          # bless by deleting
#     ply -t tools "add 17 and 25 and tell me the sum"
#
# Each generated program is four lines of /bin/sh with the bridge and the
# server command baked in as absolute paths, so the toolbox needs nothing
# else on PATH -- which matters, because with -t there is nothing else on
# PATH. Level 1 of disclosure is the synopsis ply reads from the first
# comment, level 2 is `name -h`, level 3 is running it. None of that needed
# building; it is how programs have always worked.
#
# This is not part of ply and ply does not know it exists. It is a program
# that writes programs, which is the only kind of extension ply has.

import json
import os
import re
import shutil
import stat
import subprocess
import sys
import textwrap

MARK = "# generated by mcpbox; edit freely, but -f will overwrite"
SAFE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\Z")


def die(msg, code=2):
    print(f"mcpbox: {msg}", file=sys.stderr)
    sys.exit(code)


def usage(code):
    out = sys.stdout if code == 0 else sys.stderr
    print(
        "usage: mcpbox [-f] [-b bridge] <dir> <server command ...>\n"
        "\n"
        "Write one program per MCP tool into dir, ready for ply -t dir.\n"
        "\n"
        "  -f         overwrite programs mcpbox did not write\n"
        "  -b path    the mcptools binary (default: found on PATH)\n"
        "\n"
        "Bless by deleting: generate them all, then rm the ones the model\n"
        "has no business calling. The directory is the allowlist.\n",
        file=out,
    )
    sys.exit(code)


def quote(s):
    """Single-quote a word for /bin/sh. The server command is somebody
    else's argv and lands verbatim in a script we are writing."""
    return "'" + s.replace("'", "'\\''") + "'"


def synopsis(desc):
    """One line, from however many the server sent. The first sentence is
    almost always the one that says what the tool is; everything after it is
    instructions to a model that has already decided to call it."""
    line = " ".join(desc.strip().split("\n")[0].split())
    for end in (". ", "; "):
        head, sep, _ = line.partition(end)
        if sep and len(head) >= 24:
            line = head
            break
    line = line.rstrip(".")
    return line if len(line) <= 96 else line[:93].rstrip() + "..."


# BUILD maps positional arguments onto a tool's schema. It runs under the
# interpreter mcpbox itself ran under, so the escaping is JSON's own and not
# a shell approximation of it, and the types come from the schema rather
# than from guessing. Written without a single quote anywhere: it is about
# to be embedded in a single-quoted /bin/sh string.
BUILD = """
import json, sys
spec = json.loads(sys.argv[1])
names, types = spec["order"], spec["types"]
args = sys.argv[2:]
if len(args) > len(names):
    sys.stderr.write("too many arguments: %s takes at most %d (%s)\\n"
                     % (spec["tool"], len(names), ", ".join(names)))
    sys.exit(2)
out = {}
for n, a in zip(names, args):
    t = types.get(n, "string")
    if t in ("number", "integer"):
        try:
            out[n] = int(a) if t == "integer" else float(a)
        except ValueError:
            sys.stderr.write("%s must be a %s, not %r\\n" % (n, t, a))
            sys.exit(2)
        if t == "number" and out[n] == int(out[n]):
            out[n] = int(out[n])
    elif t == "boolean":
        out[n] = a.lower() in ("1", "true", "yes", "on")
    elif t in ("object", "array"):
        try:
            out[n] = json.loads(a)
        except ValueError:
            sys.stderr.write("%s must be JSON, not %r\\n" % (n, a))
            sys.exit(2)
    else:
        out[n] = a
json.dump(out, sys.stdout)
"""


def render(name, desc, schema, bridge, server, path, python):
    """One tool, as a program.

    Arguments are positional, in schema order, because a Unix program that
    takes a library name takes a library name -- a model handed one of
    these reaches for `resolve-library-id zod` however loudly the usage
    line says JSON, and it is right to. The JSON form still works for
    anything awkward, and is what a nested object needs."""
    props = (schema or {}).get("properties") or {}
    required = set((schema or {}).get("required") or [])
    # Required first, then optional, each in the order the server declared
    # them: the caller can stop early and leave the optional ones off.
    order = [k for k in props if k in required] + [k for k in props if k not in required]

    shape = ", ".join(
        f'"{k}": {v.get("type", "any")}' for k, v in props.items()
    )
    # An MCP description is written to be injected into a model's context
    # whole, so it is routinely a page long -- Context7 spends 2kB on two
    # tools. Level 1 is a line: take the first sentence and let `-h` carry
    # the rest. That is the entire argument for a catalogue, and MCP servers
    # make it better than any hand-written toolbox could.
    first = synopsis(desc) if desc else f"the MCP tool {name}"
    if shape:
        first = f"{first} -- {{{shape}}}"

    # Line 2 is the synopsis, because that is where ply reads it from: the
    # first comment after the shebang. The rest of the help is marked #:
    # so that -h can print it and nothing else -- a housekeeping comment in
    # the same file must not turn into documentation.
    call = " ".join(f"<{k}>" if k in required else f"[{k}]" for k in order)
    lines = [
        "#!/bin/sh",
        f"# {first}",
        "#:",
        f"#: usage: {name} {call}".rstrip(),
    ]
    if props:
        shown = ", ".join(f'"{k}": ...' for k in order)
        lines.append(f"#:    or: {name} '{{{shown}}}'")
    lines.append("#:")
    for para in (desc or "").strip().split("\n"):
        for wrapped in textwrap.wrap(para, 74) or [""]:
            lines.append(f"#: {wrapped}".rstrip())
    if props:
        lines.append("#:")
        width = max(len(k) for k in props)
        for k, v in props.items():
            need = "required" if k in required else "optional"
            note = (v.get("description") or "").strip().split("\n")[0]
            lines.append(
                f"#:   {k:<{width}}  {v.get('type', 'any'):<7}  {need:<8}  {note}".rstrip()
            )
    lines += [
        "#:",
        "#: An MCP tool, reached through a bridge. The bridge and the server are",
        "#: absolute paths, because with ply -t this directory is the whole PATH.",
        MARK,
        'case "$1" in -h|--help) sed -n \'s/^#:[ ]\\{0,1\\}//p\' "$0"; exit 0 ;; esac',
        # The server needs a PATH of its own -- npx finds node through one,
        # uvx finds python -- and under ply -t there is none. That is this
        # program's business and not the model's: the model still cannot
        # name anything here, because it cannot name this program's insides.
        # Narrow it if the server needs less than this.
        f"PATH={quote(path)}; export PATH",
    ]
    if props:
        spec = json.dumps(
            {
                "tool": name,
                "order": order,
                "types": {k: props[k].get("type", "string") for k in order},
            },
            sort_keys=True,
        )
        lines += [
            "case ${1-} in",
            "  '') params='{}' ;;",
            # A leading brace is JSON and passes straight through. Anything
            # else is argv, and argv is what a program is normally handed.
            '  \\{*) params=$1 ;;',
            f"  *) params=$({quote(python)} -c {quote(BUILD)} {quote(spec)} \"$@\") || exit 2 ;;",
            "esac",
        ]
    else:
        lines.append("params='{}'")
    lines += [
        f"exec {quote(bridge)} call {quote(name)} --params \"$params\" {server}",
        "",
    ]
    return "\n".join(lines)


def main(argv):
    force, bridge = False, None
    while argv and argv[0].startswith("-") and argv[0] != "--":
        flag = argv.pop(0)
        if flag in ("-h", "--help"):
            usage(0)
        elif flag == "-f":
            force = True
        elif flag == "-b":
            if not argv:
                usage(2)
            bridge = argv.pop(0)
        else:
            usage(2)
    if argv and argv[0] == "--":
        argv.pop(0)
    if len(argv) < 2:
        usage(2)

    outdir, server = argv[0], argv[1:]
    bridge = bridge or shutil.which("mcptools")
    if not bridge:
        die("no mcptools on PATH: go install github.com/f/mcptools/cmd/mcptools@latest")
    bridge = os.path.abspath(bridge)

    # Resolve the server's own program to an absolute path too, for the same
    # reason: the toolbox it lands in may be the entire PATH.
    if server and shutil.which(server[0]):
        server[0] = os.path.abspath(shutil.which(server[0]))

    proc = subprocess.run(
        [bridge, "tools", "-f", "json", *server], capture_output=True, text=True
    )
    if proc.returncode != 0:
        die(f"listing tools: {proc.stderr.strip() or 'mcptools exited %d' % proc.returncode}")
    try:
        tools = json.loads(proc.stdout)["tools"]
    except (json.JSONDecodeError, KeyError, TypeError):
        die(f"the bridge did not return a tool list:\n{proc.stdout[:400]}")

    # The PATH mcpbox itself ran with is the one the server will need.
    runpath = os.environ.get("PATH", "/usr/bin:/bin")

    os.makedirs(outdir, exist_ok=True)
    quoted = " ".join(quote(a) for a in server)
    written, skipped = 0, []
    for t in tools:
        name = t.get("name", "")
        # A name becomes a filename and then a command. A server that names
        # a tool ../../etc/cron.d/x is not one this program helps with.
        if not SAFE.match(name):
            skipped.append((name, "unsafe name"))
            continue
        path = os.path.join(outdir, name)
        if os.path.exists(path) and not force:
            with open(path, "r", errors="replace") as f:
                if MARK not in f.read():
                    skipped.append((name, "exists and mcpbox did not write it"))
                    continue
        with open(path, "w") as f:
            f.write(render(name, t.get("description", ""), t.get("inputSchema"), bridge, quoted, runpath, sys.executable))
        os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        written += 1

    print(f"mcpbox: wrote {written} programs to {outdir}", file=sys.stderr)
    for name, why in skipped:
        print(f"mcpbox: skipped {name!r}: {why}", file=sys.stderr)
    return 1 if skipped and written == 0 else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
