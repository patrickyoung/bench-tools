#!/bin/sh
# Offline checks using installed dependencies, or explicit sibling checkouts.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bin=${WEAVE_TEST_BIN:-"$root/var/tools"}
siblings=false
while test "$#" -gt 0; do
    case "$1" in
        --bin) test "$#" -ge 2 || exit 2; bin=$2; shift 2 ;;
        --siblings) siblings=true; shift ;;
        --help) echo 'usage: tests/check [--bin directory] [--siblings]'; exit 0 ;;
        *) echo "check: unexpected argument: $1" >&2; exit 2 ;;
    esac
done
mkdir -p "$bin"
bin=$(CDPATH= cd -- "$bin" && pwd)
(cd "$root" && go build -trimpath -buildvcs=false -o "$bin/weave" .)
if "$siblings"; then
    for name in tend ask ply; do
        (cd "$root/../$name" && go build -trimpath -buildvcs=false -o "$bin/$name" .)
    done
fi
for name in tend ask ply; do
    if ! test -x "$bin/$name"; then
        echo "check: missing $bin/$name; run python3 scripts/bootstrap.py --bin '$bin' first" >&2
        exit 2
    fi
done
cd "$root"
go test ./...
go test -race ./...
go vet ./...
python3 tests/smoke "$bin/weave"
WEAVE_TEST_BIN="$bin" python3 -m unittest discover -s tests -v
