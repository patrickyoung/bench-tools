#!/usr/bin/env python3
"""Exercise the installed binary and the shipped quickstart, without other tools."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parents[1]
binary = str(Path(sys.argv[1]).resolve()) if len(sys.argv) == 2 else 'weave'
fixture = root / 'examples' / 'quickstart'
tasks = (fixture / 'tasks.jsonl').read_bytes()
rows = tasks.splitlines(keepends=True)
observations = (fixture / 'observations.jsonl').read_bytes()
assert json.loads(observations)['task_sha256'] == 'sha256:' + hashlib.sha256(rows[0].rstrip(b'\n')).hexdigest()
for data, expected in [(b'', rows[0]), (observations, b''.join(rows[1:3]))]:
    result = subprocess.run([binary, str(fixture / 'tasks.jsonl')], input=data, capture_output=True)
    assert (result.returncode, result.stdout, result.stderr) == (0, expected, b''), result
with tempfile.TemporaryDirectory(prefix='weave-smoke-') as directory:
    path = Path(directory) / 'bad.jsonl'
    path.write_bytes(tasks + b'{bad\n')
    result = subprocess.run([binary, str(path)], input=b'', capture_output=True)
    assert result.returncode == 1 and result.stdout == b'' and result.stderr
print('Installed binary and quickstart passed.')
