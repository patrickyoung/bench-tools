#!/bin/sh
set -eu
TEAM=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo 'usage: publish-decision CHECKED_ANALYSIS_RUN NEW_PUBLICATION_RUN [PROFILE_JSON]' >&2
  exit 1
fi
python3 "$TEAM/tools/team_io.py" check "$1"
python3 "$TEAM/tools/publication_io.py" prepare "$@"
RUN=$(CDPATH= cd -- "$2" && pwd)
run_role() {
 role=$1
 set -- -record-input request.json -record-output output/spec.json
 for f in "$RUN/stages/$role/inputs/"*.json; do
  [ -f "$f" ] || continue
  set -- "$@" -record-input "${f#"$RUN/stages/$role/"}"
 done
 for f in "$RUN/stages/$role/inputs/graphics/"*.png; do
  [ -f "$f" ] || continue
  set -- "$@" -record-input "${f#"$RUN/stages/$role/"}"
 done
 case "$role" in
 information-designer) set -- "$@" -record-output output/artifacts.json -record-output output/comparison.xlsx ;;
 executive-writer) set -- "$@" -record-output output/artifacts.json -record-output output/report.docx -record-output output/report.pdf -record-output output/report.md ;;
 presentation-designer) set -- "$@" -record-output output/artifacts.json -record-output output/presentation.pptx -record-output output/presentation.pdf ;;
 esac
 if "${COMPARISON_AGENT:-agent}" run -C "$RUN/stages/$role" -evidence "$RUN/records/$role" -m "$ASK_MODEL" -effort high -turns "${PUBLICATION_TURNS:-20}" -timeout "${PUBLICATION_TIMEOUT:-15m}" "$@" "$TEAM/agents/$role" -- "Read request.json and selected inputs. Your definition root is $TEAM/agents/$role . Read its CONTRACT.md, role.json and skills from that absolute definition root, not from the workspace. Its absolute tools/render command accepts the workspace path. Its absolute bin/check runs with the workspace as current directory. Produce your complete contracted professional publication output and preserve shared narrative, facts and material uncertainty." > "$RUN/records/$role/stdout.txt" 2> "$RUN/records/$role/stderr.txt"; then :; else
  code=$?
  python3 -c 'import json,sys,pathlib;pathlib.Path(sys.argv[1]).write_text(json.dumps({"status":"unfinished","stage":sys.argv[2],"exit_code":int(sys.argv[3])})+"\n")' "$RUN/status.json" "$role" "$code"
  exit "$code"
 fi
}
run_role editorial-director
for role in information-designer executive-writer presentation-designer; do
 python3 "$TEAM/tools/publication_io.py" stage "$RUN" "$role"
 run_role "$role"
done
python3 "$TEAM/tools/publication_io.py" visual-inputs "$RUN"
python3 "$TEAM/tools/publication_io.py" snapshot "$RUN"
python3 "$TEAM/tools/visual_review.py" "$RUN" "$TEAM/agents/publication-reviewer"
python3 "$TEAM/tools/publication_io.py" stage "$RUN" publication-reviewer
run_role publication-reviewer
python3 "$TEAM/tools/publication_io.py" finish "$RUN"
