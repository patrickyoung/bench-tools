#!/usr/bin/env python3
import pathlib,re,sys
p=pathlib.Path(sys.argv[1])
def fail(x): print(x); raise SystemExit(1)
if p.is_symlink() or not p.is_file(): fail("HTML must be a regular file")
s=p.read_text(errors="strict")
if len(s)<1200 or "<html" not in s.lower() or "</html>" not in s.lower(): fail("incomplete HTML document")
low=s.lower()
for pat in [r'<script[^>]+src\s*=',r'<link[^>]+href\s*=',r'<img[^>]+src\s*=\s*["\']https?://',r'url\(\s*["\']?https?://',r'\bfetch\s*\(',r'xmlhttprequest',r'\bwebsocket\s*\(']:
 if re.search(pat,low): fail("external runtime dependency or network API: "+pat)
for req in ["<style","<script","viewport","prefers-reduced-motion"]:
 if req not in low: fail("missing required single-file/accessibility feature: "+req)
if not re.search(r'<(button|a)\b',low): fail("missing interactive control")
if not ("aria-" in low or "<nav" in low): fail("missing accessibility semantics")
if not ("overflow-wrap" in low or "max-width" in low): fail("missing overflow defense")
print("static single-file HTML checks passed")
