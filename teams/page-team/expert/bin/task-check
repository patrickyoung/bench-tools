#!/usr/bin/env python3
import json,pathlib,subprocess,sys
root=pathlib.Path(__file__).resolve().parents[1]
try:
    packet=json.load(sys.stdin); candidate=json.loads(packet["candidate"])
except Exception as e:
    print("candidate must be a handoff manifest:",e); raise SystemExit(1)
p=subprocess.run([str(root/"bin/validate-handoff")],input=json.dumps(candidate),text=True)
if p.returncode: raise SystemExit(p.returncode)
worker=packet["input"]["task"]["input"]["worker"]
if candidate.get("specialist")!=worker: print("specialist does not match admitted worker"); raise SystemExit(1)
if candidate.get("task_id")!=packet["input"]["task"]["id"]: print("task identity mismatch"); raise SystemExit(1)
print("accepted checked, assignment-local artifact manifest")
