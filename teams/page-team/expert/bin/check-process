#!/usr/bin/env python3
"""Inspect Manage's accepted root result and bind the delivered HTML to it."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

if len(sys.argv) != 2:
    sys.exit('usage: check-process RUN')
try:
    run = Path(sys.argv[1]).resolve()
    observed = subprocess.run([os.environ['BENCH_MANAGE'], 'status', '-json', str(run)],
                              capture_output=True, timeout=60)
    if observed.returncode:
        sys.stderr.buffer.write(observed.stderr)
        sys.exit(observed.returncode)
    if len(observed.stdout) > 16 * 1024 * 1024:
        raise ValueError('Manage status exceeds bound')
    view = json.loads(observed.stdout)
    if view['outcome'] != 'accepted':
        raise ValueError('Manage has no accepted root result')
    candidate = json.loads(view['result'])
    manifest = json.loads((run / 'accepted-manifest.json').read_text())
    if candidate != manifest:
        raise ValueError('delivery manifest differs from accepted root result')
    files = [item for item in manifest['files'] if item['path'] == 'output/index.html']
    if len(files) != 1:
        raise ValueError('expected one accepted HTML artifact')
    item = files[0]
    source = Path(item['source'])
    parts = source.relative_to(run).parts
    current = run
    for part in parts:
        current = current / part
        if current.is_symlink():
            raise ValueError('artifact traverses symlink')
    delivery = run / 'result.html'
    if delivery.is_symlink() or not source.is_file() or not delivery.is_file():
        raise ValueError('delivery must contain regular files')
    if source.stat().st_size > 16 * 1024 * 1024 or delivery.stat().st_size > 16 * 1024 * 1024:
        raise ValueError('HTML exceeds bound')
    original, delivered = source.read_bytes(), delivery.read_bytes()
    if (delivered != original or len(original) != item['bytes'] or
            hashlib.sha256(original).hexdigest() != item['sha256']):
        raise ValueError('delivered HTML differs from reviewed artifact')
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
    sys.exit('page delivery: ' + str(error))
print('accepted Manage root result and exact reviewed HTML delivery')
