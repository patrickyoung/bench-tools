# Copy to private operator configuration, replace placeholders, and export the
# selected values before running the assembled team. Keep credentials elsewhere.
AGENT=/path/to/bench-tools/.build/bin/agent
BENCH_MANAGE=/path/to/bench-manage/bin/bench-manage
ASK=/path/to/bench-tools/.build/bin/ask
PLY=/path/to/bench-tools/.build/bin/ply
TEND=/path/to/bench-tools/.build/bin/tend
WEAVE=/path/to/bench-tools/.build/bin/weave
PAGE_TEAM_MODEL=provider/model
PAGE_TEAM_RUN=/absolute/path/to/runs/assignment-001
PAGE_TEAM_IMAGEGEN=/path/to/imagegen-filter
BLENDER=/path/to/blender
GIMP_CONSOLE=/path/to/gimp-console
# Optional: absolute path to a trusted acceptance module. Leave unset to use
# the page's declared interaction journeys with the default browser checker.
# PAGE_TEAM_BROWSER_CHECK=/absolute/path/to/product-checks.mjs
PAGE_TEAM_BROWSER=/path/to/operator-selected/chromium
