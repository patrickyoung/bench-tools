#!/usr/bin/env python3
"""Verify a completed comparison delivery, including its independent verdict."""
import json
import os
from pathlib import Path
import subprocess
import sys

if len(sys.argv) != 2:
    sys.exit('usage: check-process RUN')
run = Path(sys.argv[1]).resolve()
root = Path(__file__).resolve().parents[1]
env = dict(os.environ, COMPARISON_RUN=str(run), PYTHONDONTWRITEBYTECODE='1')
result = subprocess.run([str(root / 'bin/check')], cwd=run, env=env)
if result.returncode:
    sys.exit(result.returncode)
try:
    status = json.loads((run / 'status.json').read_text())
    manifest = json.loads((run / 'result/manifest.json').read_text())
    review = json.loads((run / 'result/review.json').read_text())
    if (status['status'] != 'reviewed' or manifest['status'] != 'reviewed' or
            review['status'] != 'ready' or review['details']['decision'] != 'proceed'):
        sys.exit('comparison delivery still requires revision or input')
except (OSError, ValueError, KeyError, TypeError) as error:
    sys.exit('invalid comparison delivery: ' + str(error))
print('accepted independently reviewed comparison delivery; no purchase authorized')
