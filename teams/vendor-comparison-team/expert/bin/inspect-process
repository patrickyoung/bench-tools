#!/usr/bin/env python3
"""Read a comparison's retained business disposition; never rerun stages."""
import json
from pathlib import Path
import sys

try:
    if len(sys.argv) != 2:
        raise ValueError('usage: inspect-process RUN')
    path = Path(sys.argv[1]) / 'status.json'
    status = json.loads(path.read_text()) if path.is_file() else {}
    outcome = {'requires-revision': 'needs-revision', 'needs-input': 'needs-input'}.get(status.get('status'), 'unfinished')
    print(json.dumps({'outcome': outcome}))
except (OSError, ValueError, KeyError, TypeError) as error:
    sys.exit('comparison process inspection: ' + str(error))
