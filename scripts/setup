#!/usr/bin/env python3
"""Set up Bench's builder tools and a reusable harness handoff; call no model."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shlex
import stat
import subprocess
import sys
import tempfile

from prebuilt_support import prepare_prebuilt

ROOT = Path(__file__).resolve().parents[1]
TOOLS = ("hire", "agent", "ask", "brief", "ply", "cage", "record", "trail", "hone")
OWNER = "bench-tools/scripts/setup"


def digest(data):
    return hashlib.sha256(data).hexdigest()


@contextmanager
def state_lock(directory):
    directory.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(directory / ".setup.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    with os.fdopen(descriptor, "r+") as lock:
        if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
            raise ValueError("setup lock must be a regular file")
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def inspect_state(directory):
    """Protect operator edits, including a previous unowned setup handoff."""
    receipt = directory / "setup.json"
    if receipt.is_symlink():
        raise ValueError("setup receipt must not be a symlink: " + str(receipt))
    previous = json.loads(receipt.read_text()) if receipt.exists() else {}
    if not isinstance(previous, dict) or (previous and previous.get("producer") != OWNER):
        raise ValueError("unmanaged setup receipt: " + str(receipt))
    if previous and (previous.get("schema") != 1 or not isinstance(previous.get("files"), dict)):
        raise ValueError("invalid setup receipt: " + str(receipt))
    for name in ("BENCH-SETUP.md", "env.sh"):
        path = directory / name
        if path.is_symlink():
            raise ValueError("setup file must not be a symlink: " + str(path))
        if path.exists() and previous.get("files", {}).get(name) != digest(path.read_bytes()):
            raise ValueError("preserving existing or edited " + str(path) +
                             "; choose a new --state-dir or reconcile the handoff first")


def command(argv, env=None):
    result = subprocess.run(list(map(str, argv)), cwd=ROOT, env=env,
                            capture_output=True, text=True)
    return {"argv": list(map(str, argv)), "exit": result.returncode,
            "stdout": result.stdout, "stderr": result.stderr}


def write_state(directory, source, prefix, checks, packages, original_receipt):
    revision = command(["git", "rev-parse", "HEAD"])
    changes = command(["git", "status", "--porcelain"])
    source_id = revision["stdout"].strip() if revision["exit"] == 0 else "unavailable (source archive)"
    dirty = changes["exit"] != 0 or bool(changes["stdout"])
    passed = all(item["exit"] == 0 for item in checks)
    env_text = ("# Generated by " + OWNER + "; source this in the harness shell.\n" +
                "export BENCH_SOURCE=" + shlex.quote(str(source)) + "\n" +
                "export BENCH_PREFIX=" + shlex.quote(str(prefix)) + "\n" +
                "export PATH=" + shlex.quote(str(prefix / "bin")) + ':"$PATH"\n')
    lines = ["# Bench setup", "", "Generated by `" + OWNER + "`. Keep personal notes in a separate file.", "",
             "- Source: `" + str(source) + "`", "- Source commit: `" + source_id + "`",
             "- Checkout has local changes or cannot be checked: " + str(dirty).lower(),
             "- Runtime prefix: `" + str(prefix) + "`",
             "- Setup checks: " + ("passed" if passed else "incomplete; see checks below"),
             "- Model access: not tested; setup makes no model calls.",
             "- Host skill discovery: verify in a fresh host session after installation.",
             "- Selected worker/team dependencies: install when a job selects them.", "",
             "Load command paths in each new shell:", "", "```sh",
             ". " + shlex.quote(str(directory / "env.sh")), "```", "",
             "## Checks", ""]
    for item in checks:
        lines += ["### " + shlex.join(item["argv"]), "", "Exit: " + str(item["exit"]), "", "```text",
                  (item["stdout"] + item["stderr"]).strip(), "```", ""]
    lines += ["## Installed package sources", "",
              "These identify the installed binaries separately from the checkout above.",
              "Prebuilt packages can come from a different commit; full receipts remain",
              "under the runtime's lib/bench-tools directory.", "", "```json",
              json.dumps(packages, indent=2), "```", "",
              "## Next session", "", "Read the Bench skill and its setup reference in the selected source. Use",
              "the existing host plugin/skill; do not install a duplicate copy. Catalogs:", "", "```sh",
              "python3 " + shlex.quote(str(source / "scripts/workers")) + " list --all",
              "python3 " + shlex.quote(str(source / "scripts/workers")) + " list --teams --all", "```", "",
              "Record the selected model/provider and any approved Ask wrapper in the private",
              "job runbook without secrets. Preserve AGENT_ASK and ASK selections. Setup does",
              "not change credentials, shell profiles, host permissions, or model configuration.", "",
              "For another setup prefix, select a separate --state-dir. For an update, select",
              "the source revision deliberately and repeat scripts/setup with this prefix and",
              "state directory. Tool receipts under lib/bench-tools identify installed bytes.", ""]
    files = {"env.sh": env_text, "BENCH-SETUP.md": "\n".join(lines)}
    record = {"producer": OWNER, "schema": 1, "source": str(source), "source_commit": source_id,
              "source_dirty": dirty, "prefix": str(prefix), "checks": checks,
              "installed_sources": packages,
              "files": {name: digest(content.encode()) for name, content in files.items()}}
    # Compilation and checks can take time. Preserve operator edits made
    # during that interval as well as files that predated this invocation.
    inspect_state(directory)
    receipt = directory / "setup.json"
    current_receipt = receipt.read_bytes() if receipt.exists() else None
    if current_receipt != original_receipt:
        raise ValueError("setup receipt changed during installation; preserving the current handoff")
    directory.mkdir(parents=True, exist_ok=True)
    for name, content in files.items():
        (directory / name).write_text(content)
    (directory / "setup.json").write_text(json.dumps(record, indent=2) + "\n")
    return passed


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prefix", type=Path, default=Path.home() / ".local/share/bench/runtime",
                        help="tool prefix (default: ~/.local/share/bench/runtime)")
    parser.add_argument("--state-dir", type=Path, default=Path.home() / ".local/share/bench",
                        help="setup handoff directory (default: ~/.local/share/bench)")
    route = parser.add_mutually_exclusive_group()
    route.add_argument("--from-build", type=Path, help="use existing verified packages; no compiler required")
    route.add_argument("--from-source", action="store_true", help="build locally instead of using pinned published packages")
    args = parser.parse_args(argv)
    try:
        repository = command(["git", "rev-parse", "--show-toplevel"])
        if repository["exit"] != 0 or Path(repository["stdout"].strip()).resolve() != ROOT:
            raise ValueError("setup needs its own Git checkout; clone https://github.com/patrickyoung/bench-tools.git first")
        state = args.state_dir.expanduser().absolute()
        if state.is_symlink():
            raise ValueError("setup directory must not be a symlink")
        state = state.resolve()
        if state == ROOT or ROOT in state.parents:
            raise ValueError("keep setup state outside the source checkout")
        prefix = args.prefix.expanduser().absolute()
        if prefix.is_symlink():
            raise ValueError("runtime prefix must not be a symlink")
        prefix = prefix.resolve()
        if prefix == ROOT or ROOT in prefix.parents:
            raise ValueError("keep installed commands outside the source checkout")
        with state_lock(state):
            inspect_state(state)
            receipt = state / "setup.json"
            original_receipt = receipt.read_bytes() if receipt.exists() else None
            if original_receipt is not None:
                previous = json.loads(original_receipt)
                if previous.get("prefix") != str(prefix) or previous.get("source") != str(ROOT):
                    raise ValueError("setup handoff selects a different source or prefix; use a separate --state-dir")
            install = [sys.executable, ROOT / "scripts/install", *TOOLS, "--prefix", prefix]
            with tempfile.TemporaryDirectory(prefix="bench-setup-packages-") as scratch:
                packages = args.from_build.expanduser().resolve() if args.from_build else None
                if not args.from_build and not args.from_source:
                    packages = prepare_prebuilt(ROOT, TOOLS, Path(scratch))
                if packages:
                    install += ["--from-build", packages]
                subprocess.run(list(map(str, install)), cwd=ROOT, check=True)
            env = dict(os.environ, PATH=str(prefix / "bin") + os.pathsep + os.environ.get("PATH", os.defpath))
            # This probe checks the selected pair even if the caller uses a
            # separate HIRE_AGENT wrapper for their actual model-backed work.
            env["HIRE_AGENT"] = str(prefix / "bin/agent")
            checks = []
            for argv in ([prefix / "bin" / name, "version"] for name in TOOLS):
                checks.append(command(argv, env))
            checks.append(command([prefix / "bin/hire", "verify", ROOT / "examples/support-reply/expert"], env))
            checks.append(command([prefix / "bin/cage", "check"], env))
            packages = {}
            for name in TOOLS:
                source = json.loads((prefix / "lib/bench-tools" / name / "package.json").read_text()).get("source", {})
                packages[name] = {key: value for key, value in source.items() if key != "files"}
            passed = write_state(state, ROOT, prefix, checks, packages, original_receipt)
        for item in checks:
            print(("ok " if item["exit"] == 0 else "FAILED ") + shlex.join(item["argv"]))
            if item["exit"]:
                print(item["stdout"] + item["stderr"], file=sys.stderr)
        print("Setup handoff: " + str(state / "BENCH-SETUP.md"))
        print("Load command paths: . " + shlex.quote(str(state / "env.sh")))
        if not passed:
            print("Commands installed, but setup checks are incomplete. Read the handoff; do not bypass confinement.", file=sys.stderr)
        return 0 if passed else 1
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print("setup: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
