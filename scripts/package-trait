#!/usr/bin/env python3
"""Package the independently built Trait core and selected Bench executables."""

import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
from install_support import InstallError, verify_package

ROOT = Path(__file__).resolve().parents[1]
COMPANIONS = ("hire", "agent", "ask", "brief", "ply", "cage", "record", "hone")


def package_for(bins, name):
    executable = (bins / name).resolve(strict=True)
    package = executable.parent.parent
    receipt = verify_package(package, name)
    if receipt["commands"] != [name] or executable != package / "bin" / name:
        raise InstallError(f"expected independent {name} package at {package}")
    return package


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runtime", required=True, type=Path,
                        help="verified installed Bench prefix to embed")
    parser.add_argument("--output", required=True, type=Path, help="new native executable")
    parser.add_argument("--bin-dir", type=Path, default=ROOT / ".build/bin",
                        help="independently built trait and bundle commands (default: .build/bin)")
    args = parser.parse_args(argv)
    try:
        bins = args.bin_dir.resolve(strict=True)
        core = package_for(bins, "trait")
        builder = package_for(bins, "bundle") / "bin/bundle"
        runtime = args.runtime.resolve(strict=True)
        for name in COMPANIONS:
            verify_package(runtime / "lib/bench-tools" / name, name)
        with tempfile.TemporaryDirectory(prefix="package-trait-") as temporary:
            app = Path(temporary) / "app"
            app.mkdir()
            shutil.copytree(core, app / "core", symlinks=True)
            verify_package(app / "core", "trait")
            files = []
            for path in sorted(app.rglob("*")):
                if path.is_symlink():
                    raise InstallError(f"Trait app cannot contain a symlink: {path}")
                if path.is_file():
                    files.append(path.relative_to(app).as_posix())
            manifest = {"schema": 1, "name": "trait", "interface": "argv",
                        "description": "Create, edit, teach and evaluate reusable workers.",
                        "entry": "core/bin/trait", "files": files,
                        "requires": list(COMPANIONS)}
            (app / "app.json").write_text(json.dumps(manifest, indent=2) + "\n")
            command = [str(builder), "build", "-o", str(args.output.absolute()),
                       "-runtime", str(runtime)]
            for name in COMPANIONS:
                command.extend(("-tool", name))
            command.append(str(app))
            return subprocess.run(command, check=False).returncode
    except (InstallError, OSError, ValueError) as error:
        print(f"package-trait: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
