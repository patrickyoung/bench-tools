#!/usr/bin/env python3
"""Verify the unchanged initial import and its complete source ancestry."""
import json
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parents[1]


def git(*args):
    return subprocess.check_output(['git', '-C', str(root), *args], text=True).strip()


def main():
    components = json.loads((root / 'components.json').read_text())['components']
    for component in components:
        name, path, source = component['name'], component['path'], component['source']
        if source.get('origin') == 'monorepo':
            raise ValueError(name + ': monorepo-native source has no initial import; use current source checks')
        if git('rev-parse', source['commit'] + '^{tree}') != source['tree']:
            raise ValueError(name + ': source commit/tree mismatch')
        subprocess.run(['git', '-C', str(root), 'merge-base', '--is-ancestor',
                        source['commit'], 'HEAD'], check=True)
        if git('rev-parse', 'HEAD:' + path) != source['tree']:
            raise ValueError(name + ': committed component differs from import baseline')
        if git('status', '--porcelain', '--untracked-files=all', '--', path):
            raise ValueError(name + ': component has uncommitted changes')
        print(name + ': exact source tree, clean component, original ancestry')
    print(f'{len(components)} unchanged imports verified')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        print('verify-imports: ' + str(error), file=sys.stderr)
        sys.exit(1)
