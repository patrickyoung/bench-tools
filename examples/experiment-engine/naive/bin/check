#!/usr/bin/env python3
"""Check the result's structure and IDs, not meaning."""
import json
import sys
from pathlib import Path

def unique(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('duplicate key')
        result[key] = value
    return result

raw = sys.stdin.buffer.read(1024 * 1024 + 1)
if not raw.strip():
    print('Return the routing result.')
    sys.exit(1)
try:
    request = json.loads(Path('request.json').read_text(), object_pairs_hook=unique)
    ids = [note['id'] for note in request['notes']]
    if not ids or len(set(ids)) != len(ids):
        raise ValueError('invalid request')
except (OSError, ValueError, KeyError, TypeError):
    print('Checker cannot read a valid selected request.', file=sys.stderr)
    sys.exit(2)
try:
    if len(raw) > 1024 * 1024:
        raise ValueError('oversize')
    result = json.loads(raw, object_pairs_hook=unique)
    if not isinstance(result, list) or len(result) != len(ids):
        raise ValueError('wrong rows')
    for row, expected_id in zip(result, ids):
        if (not isinstance(row, dict) or set(row) != {'id', 'queue'}
                or row['id'] != expected_id
                or row['queue'] not in ('security', 'billing', 'technical', 'general')):
            raise ValueError('invalid row')
except (ValueError, KeyError, TypeError):
    print('Return one {id, queue} object per input note, in order, with an allowed queue.')
    sys.exit(1)
