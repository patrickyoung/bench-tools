#!/bin/sh
# Runs in the workspace. Source identities come from the expert definition.
if [ ! -f reply.md ] || [ -L reply.md ] || [ ! -s reply.md ]; then
    echo 'Write a nonempty regular reply.md with citations to the supplied policy.' >&2
    exit 1
fi
expert_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
cite "$expert_dir/sources.jsonl" < reply.md > /dev/null
