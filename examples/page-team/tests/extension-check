#!/usr/bin/env python3
import json,pathlib,subprocess,sys
p=json.load(sys.stdin);data=p['input']
# The exact bundle is supplied via the operator's environment.
import os
root=pathlib.Path(os.environ['EXTENSION_BUNDLE'])
r=subprocess.run([str(root/'bin/materialize-inputs')],input=json.dumps({'dependencies':data['dependencies']}).encode())
if r.returncode: raise SystemExit(r.returncode)
dep=data['dependencies'][0];f=pathlib.Path('inputs')/dep['job']/'output/edited.txt'
if f.read_text().strip()!='The player shows composure under pressure. Further live observation is needed.': raise SystemExit(1)
print('new specialist executed through unchanged adapter and produced the exact uncertainty-preserving edit')
